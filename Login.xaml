<Window x:Class="ProyectoRuben.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Login"
        WindowStyle="None"
        ResizeMode="NoResize"
        Height="480" Width="820"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

	<Border CornerRadius="12" ClipToBounds="True">
    <Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="1.3*"/>
			</Grid.ColumnDefinitions>

			<!-- ══════════════════════════════════ -->
			<!-- Panel izquierdo: branding/degradado -->
			<!-- ══════════════════════════════════ -->
			<Border Grid.Column="0" CornerRadius="12,0,0,12">
				<Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource SecondaryColor}" Offset="1"/>
                    </LinearGradientBrush>
				</Border.Background>
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
					<Image Source="/Recursos/Imagenes/logo.jpg"
                           Width="120" Height="65" Margin="0,0,0,20"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
					<TextBlock Text="Peluquería Charo"
                               FontSize="20" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
					<TextBlock Text="Sistema de Gestión"
                               FontSize="13" Foreground="#DDDDDD"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
				</StackPanel>
        </Border>

			<!-- ══════════════════════════════════ -->
			<!-- Panel derecho: formulario          -->
			<!-- ══════════════════════════════════ -->
			<Border Grid.Column="1" Background="White" CornerRadius="0,12,12,0">
            <Grid>
					<!-- Botón cerrar anclado arriba-derecha -->
					<Button x:Name="btnCerrar"
                            Content="✕"
                            Width="32" Height="32"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                            Margin="0,10,10,0"
                        Background="Transparent"
                            Foreground="#999999"
                        BorderThickness="0"
                        Cursor="Hand"
                            FontSize="14"
                        Click="btnCerrar_Click"/>

					<!-- Formulario centrado -->
					<StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Width="260"
                                Margin="0,40,0,30">

						<TextBlock Text="Iniciar Sesión"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,28"/>

						<TextBox x:Name="txtUsuario"
                                 materialDesign:HintAssist.Hint="Usuario"
                                 Style="{StaticResource MaterialDesignFilledTextBox}"
                                 Margin="0,0,0,16"/>

						<PasswordBox x:Name="txtPassword"
                                     materialDesign:HintAssist.Hint="Contraseña"
                                     Style="{StaticResource MaterialDesignFilledRevealPasswordBox}"
                                     Margin="0,0,0,24"/>

                    <!-- Botón usando tu estilo del tema -->
                    <Button x:Name="btnLogin"
                                Content="ENTRAR"
                            Style="{StaticResource PrimaryButton}"
                                Height="42"
                                IsDefault="True"
                                Click="btnLogin_Click"/>

                    <TextBlock x:Name="txtMensaje"
                               Foreground="{StaticResource ErrorBrush}"
                               TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
	</Border>
</Window>
