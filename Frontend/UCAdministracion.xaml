<UserControl x:Class="ProyectoRuben.Frontend.UCAdministracion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<UserControl.Resources>
		<BooleanToVisibilityConverter x:Key="BoolToVis"/>
	</UserControl.Resources>

	<Grid Margin="0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ CABECERA ══ -->
		<Border Grid.Row="0" Background="White" Padding="28,20" Margin="0,0,0,20">
			<Border.Effect>
				<DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                  Color="#000000" Opacity="0.06"/>
			</Border.Effect>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel>
					<TextBlock Text="Usuarios y Permisos" FontSize="22"
                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
					<TextBlock Text="Gestiona los usuarios del sistema y sus permisos por rol"
                               FontSize="13" Foreground="#888888" Margin="0,4,0,0"/>
				</StackPanel>
				<TextBlock Grid.Column="1" Text="{Binding Mensaje}"
                           FontSize="13" Foreground="{StaticResource AccentBrush}"
                           VerticalAlignment="Center" Margin="20,0,0,0"/>
			</Grid>
		</Border>

		<!-- ══ CONTENIDO ══ -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="1.5*"/>
				<ColumnDefinition Width="20"/>
				<ColumnDefinition Width="1.5*"/>
			</Grid.ColumnDefinitions>

			<!-- ── Columna 1: Lista de usuarios ── -->
			<Border Grid.Column="0" Background="White" CornerRadius="12" Padding="20">
				<Border.Effect>
					<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                      Color="#000000" Opacity="0.05"/>
				</Border.Effect>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Grid.Row="0" Text="Usuarios del sistema" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,15"/>

					<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
						<ItemsControl ItemsSource="{Binding ListaUsuarios}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Margin="0,0,0,8" CornerRadius="8"
                                            Padding="14,10" Cursor="Hand">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="#F8F9FA"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding Activo}" Value="False">
														<Setter Property="Background" Value="#FFF3F3"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<Border.InputBindings>
											<MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SeleccionarUsuarioCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"/>
										</Border.InputBindings>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="Auto"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<!-- Avatar -->
											<Border Grid.Column="0" Width="38" Height="38"
                                                    CornerRadius="19"
                                                    Background="{StaticResource AccentBrush}"
                                                    Margin="0,0,12,0">
												<TextBlock Text="{Binding Nombre,
                                                           Converter={StaticResource StringToFirstCharConverter}}"
                                                           Foreground="White" FontSize="15"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
											</Border>

											<!-- Info -->
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock Text="{Binding Nombre}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
												<StackPanel Orientation="Horizontal">
													<TextBlock Text="{Binding Rol}"
                                                               FontSize="11" Foreground="#888888"/>
													<TextBlock Text=" · " FontSize="11"
                                                               Foreground="#BBBBBB"/>
													<TextBlock FontSize="11">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Text" Value="Activo"/>
																<Setter Property="Foreground" Value="Green"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Activo}"
                                                                                 Value="False">
																		<Setter Property="Text" Value="Inactivo"/>
																		<Setter Property="Foreground" Value="#E53935"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</StackPanel>
											</StackPanel>

											<!-- Botón activar/desactivar -->
											<Button Grid.Column="2"
                                                    Command="{Binding DataContext.ToggleActivoCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Width="32" Height="32"
                                                    Background="Transparent" BorderThickness="0"
                                                    Cursor="Hand" ToolTip="Activar / Desactivar">
												<materialDesign:PackIcon Width="18" Height="18">
													<materialDesign:PackIcon.Style>
														<Style TargetType="materialDesign:PackIcon">
															<Setter Property="Kind" Value="AccountCheck"/>
															<Setter Property="Foreground" Value="Green"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Activo}"
                                                                             Value="False">
																	<Setter Property="Kind" Value="AccountOff"/>
																	<Setter Property="Foreground" Value="#E53935"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</materialDesign:PackIcon.Style>
												</materialDesign:PackIcon>
											</Button>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>

			<!-- ── Columna 2: Crear usuario ── -->
			<Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"
                    VerticalAlignment="Top">
				<Border.Effect>
					<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                      Color="#000000" Opacity="0.05"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Text="Crear nuevo usuario" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,18"/>

					<TextBlock Text="Nombre *" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
					<TextBox Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Margin="0,0,0,12" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13"/>

					<TextBlock Text="Email" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
					<TextBox Text="{Binding NuevoEmail, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Margin="0,0,0,12" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13"/>

					<TextBlock Text="Teléfono" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
					<TextBox Text="{Binding NuevoTelefono, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Margin="0,0,0,12" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13"/>

					<TextBlock Text="Contraseña *" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
					<TextBox Text="{Binding NuevoContrasena, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Margin="0,0,0,12" Padding="10,0"
                             VerticalContentAlignment="Center" FontSize="13"/>
					<TextBlock Text="Rol *" FontSize="12" Foreground="#666666" Margin="0,0,0,8"/>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
						<RadioButton x:Name="rbEmpleado"
									 Content="Empleado"
									 GroupName="Rol"
									 FontSize="13"
									 Margin="0,0,20,0"
									 IsChecked="True"
									 Checked="RbEmpleado_Checked">
							<RadioButton.Style>
								<Style TargetType="RadioButton" BasedOn="{x:Null}">
									<Setter Property="Foreground" Value="#333333"/>
									<Setter Property="FontSize" Value="13"/>
								</Style>
							</RadioButton.Style>
						</RadioButton>
						<RadioButton x:Name="rbAdmin"
									 Content="Administrador"
									 GroupName="Rol"
									 FontSize="13"
									 Checked="RbAdmin_Checked">
							<RadioButton.Style>
								<Style TargetType="RadioButton" BasedOn="{x:Null}">
									<Setter Property="Foreground" Value="#333333"/>
									<Setter Property="FontSize" Value="13"/>
								</Style>
							</RadioButton.Style>
						</RadioButton>
					</StackPanel>

					<Button Content="Crear Usuario"
                            Command="{Binding CrearUsuarioCommand}"
                            Height="40" FontSize="13" FontWeight="SemiBold"
                            Cursor="Hand">
						<Button.Style>
							<Style TargetType="Button">
								<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
								<Setter Property="Foreground" Value="White"/>
								<Setter Property="BorderThickness" Value="0"/>
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="Button">
											<Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="0,10">
												<ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</Button.Style>
					</Button>
				</StackPanel>
			</Border>

			<!-- ── Columna 3: Permisos del rol ── -->
			<Border Grid.Column="4" Background="White" CornerRadius="12" Padding="20"
                    VerticalAlignment="Top">
				<Border.Effect>
					<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270"
                                      Color="#000000" Opacity="0.05"/>
				</Border.Effect>
				<StackPanel>
					<TextBlock Text="Permisos del rol" FontSize="15"
                               FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,4"/>
					<TextBlock FontSize="12" Foreground="#888888" Margin="0,0,0,16"
                               TextWrapping="Wrap">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Text"
                                        Value="Selecciona un usuario para ver y editar los permisos de su rol."/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding HayUsuarioSeleccionado}" Value="True">
										<Setter Property="Text"
                                                Value="{Binding UsuarioSeleccionado.Nombre,
                                                StringFormat='Rol de: {0}'}"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<ItemsControl ItemsSource="{Binding PermisosDelRol}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<CheckBox IsChecked="{Binding Concedido}"
                                          Content="{Binding Permiso.Nombre}"
                                          FontSize="13" Margin="0,0,0,10"
                                          Foreground="{StaticResource TextBrush}"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<Button Content="Guardar Permisos"
                            Command="{Binding GuardarPermisosCommand}"
                            Margin="0,16,0,0" Height="40"
                            FontSize="13" FontWeight="SemiBold"
                            Visibility="{Binding HayUsuarioSeleccionado,
                                         Converter={StaticResource BoolToVis}}"
                            Cursor="Hand">
						<Button.Style>
							<Style TargetType="Button">
								<Setter Property="Background" Value="#43A047"/>
								<Setter Property="Foreground" Value="White"/>
								<Setter Property="BorderThickness" Value="0"/>
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate TargetType="Button">
											<Border Background="{TemplateBinding Background}"
                                                    CornerRadius="8" Padding="0,10">
												<ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</Button.Style>
					</Button>
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</UserControl>