<Window x:Class="ProyectoRuben.Frontend.AgregarCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="AgregarCliente_Loaded"
        Title="Cliente"
        Height="460" Width="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7"
        WindowStyle="None"
        AllowsTransparency="True">

	<Border CornerRadius="16" ClipToBounds="True" Background="#F5F6F7">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270"
                              Color="#000000" Opacity="0.15"/>
		</Border.Effect>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="64"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- ═══ BARRA TÍTULO ═══ -->
			<Border Grid.Row="0" Background="#2D3436" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
				<Grid Margin="20,0">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<Border Width="32" Height="32" CornerRadius="8"
                                Background="#D4A574" Margin="0,0,12,0">
							<materialDesign:PackIcon Kind="AccountPlus"
                                                     Width="18" Height="18"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
						</Border>
						<TextBlock x:Name="TxtTituloVentana"
                                   Text="Nuevo Cliente"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
					</StackPanel>
					<Button HorizontalAlignment="Right"
                            Width="32" Height="32"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" IsCancel="True" Click="Cancelar_Click">
						<materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="#AAAAAA"/>
					</Button>
				</Grid>
			</Border>

			<!-- ═══ CONTENIDO ═══ -->
			<StackPanel Grid.Row="1" Margin="28,24,28,28">

				<!-- ── NOMBRE ── -->
				<TextBlock Text="NOMBRE" FontSize="11" FontWeight="SemiBold"
                           Foreground="#636E72" Margin="0,0,0,6"/>
				<Border Background="White" CornerRadius="8"
                        BorderBrush="#DFE6E9" BorderThickness="1"
                        Margin="0,0,0,16">
					<TextBox x:Name="TxtNombre"
                             Text="{Binding ClienteNuevo.Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" BorderThickness="0"
                             Background="Transparent"
                             Foreground="#2D3436" FontSize="14"
                             Padding="12,0" VerticalContentAlignment="Center">
						<TextBox.Template>
							<ControlTemplate TargetType="TextBox">
								<Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
									<ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</TextBox.Template>
					</TextBox>
				</Border>

				<!-- ── TELÉFONO ── -->
				<TextBlock Text="TELÉFONO" FontSize="11" FontWeight="SemiBold"
                           Foreground="#636E72" Margin="0,0,0,6"/>
				<Border Background="White" CornerRadius="8"
                        BorderBrush="#DFE6E9" BorderThickness="1"
                        Margin="0,0,0,16">
					<TextBox x:Name="TxtTelefono"
                             Text="{Binding ClienteNuevo.Telefono, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" BorderThickness="0"
                             Background="Transparent"
                             Foreground="#2D3436" FontSize="14"
                             Padding="12,0" VerticalContentAlignment="Center">
						<TextBox.Template>
							<ControlTemplate TargetType="TextBox">
								<Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
									<ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</TextBox.Template>
					</TextBox>
				</Border>

				<!-- ── EMAIL ── -->
				<TextBlock Text="EMAIL" FontSize="11" FontWeight="SemiBold"
                           Foreground="#636E72" Margin="0,0,0,6"/>
				<Border Background="White" CornerRadius="8"
                        BorderBrush="#DFE6E9" BorderThickness="1"
                        Margin="0,0,0,32">
					<TextBox x:Name="TxtEmail"
                             Text="{Binding ClienteNuevo.Email, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" BorderThickness="0"
                             Background="Transparent"
                             Foreground="#2D3436" FontSize="14"
                             Padding="12,0" VerticalContentAlignment="Center">
						<TextBox.Template>
							<ControlTemplate TargetType="TextBox">
								<Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
									<ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</TextBox.Template>
					</TextBox>
				</Border>

				<!-- ── BOTONES ── -->
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<Button Grid.Column="0" Content="Cancelar"
                            Height="44" Background="#F5F6F7"
                            Foreground="#636E72" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="1" BorderBrush="#DFE6E9"
                            Cursor="Hand" IsCancel="True" Click="Cancelar_Click">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
									<ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>

					<Button Grid.Column="2"
                            x:Name="BtnGuardar"
                            Content="Guardar"
                            Height="44" Background="#D4A574"
                            Foreground="White" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            IsDefault="True" Click="Guardar_Click">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8"
                                        Background="{TemplateBinding Background}">
									<ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</Grid>

			</StackPanel>
		</Grid>
	</Border>
</Window>
