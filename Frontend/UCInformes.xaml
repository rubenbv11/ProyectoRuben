<UserControl x:Class="ProyectoRuben.Frontend.UCInformes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ ENCABEZADO ══ -->
		<Border Grid.Row="0" Background="White" Padding="32,20"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Informes y Análisis" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Analiza el rendimiento del negocio por período"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0"/>
				</StackPanel>

				<!-- Controles derecha -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

					<!-- Selector de período -->
					<Border Background="{StaticResource LightGrayBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1"
                            Margin="0,0,12,0" Height="40">
						<ComboBox ItemsSource="{Binding Periodos}"
                                  SelectedItem="{Binding PeriodoSeleccionado}"
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextBrush}" FontSize="13"
                                  FontWeight="SemiBold" Padding="12,0" MinWidth="160"
                                  VerticalContentAlignment="Center"/>
					</Border>

					<!-- Refrescar -->
					<Button Width="40" Height="40" Background="Transparent"
                            BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                            Cursor="Hand" Margin="0,0,10,0" ToolTip="Refrescar datos"
                            Command="{Binding RefrescarCommand}">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
						<materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                 Foreground="{StaticResource TextLightBrush}"/>
					</Button>

					<!-- Exportar
					<Button Height="40" Padding="16,0" Cursor="Hand"
                            Background="{StaticResource AccentBrush}" BorderThickness="0"
                            Command="{Binding ExportarExcelCommand}">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8" Background="{TemplateBinding Background}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
						<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
							<materialDesign:PackIcon Kind="FileExcelOutline" Width="18" Height="18"
                                                     Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
							<TextBlock Text="Exportar CSV" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					 -->
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENIDO PRINCIPAL ══ -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="28,20,28,28">

				<!-- Sin datos -->
				<Border Background="White" CornerRadius="12" Padding="40"
                        Visibility="{Binding SinDatos, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel HorizontalAlignment="Center">
						<materialDesign:PackIcon Kind="ChartBar" Width="56" Height="56"
                                                 Foreground="{StaticResource MediumGrayBrush}"
                                                 HorizontalAlignment="Center" Margin="0,0,0,16"/>
						<TextBlock Text="Sin datos para este período" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
						<TextBlock Text="No hay facturas pagadas en el rango seleccionado"
                                   FontSize="13" Foreground="{StaticResource TextLightBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
					</StackPanel>
				</Border>

				<!-- Datos -->
				<StackPanel Visibility="{Binding SinDatos, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">

					<!-- ══ FILA 1: KPIs ══ -->
					<Grid Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Ingresos totales -->
						<Border Grid.Column="0" Background="#2D3436" CornerRadius="14" Padding="20,18">
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,12">
									<Border Width="36" Height="36" CornerRadius="10" Background="#D4A574">
										<materialDesign:PackIcon Kind="CurrencyEur" Width="18" Height="18"
                                                                 Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
								<TextBlock Text="{Binding IngresosTotalesTexto}" FontSize="24" FontWeight="Bold"
                                           Foreground="White" Margin="0,0,0,4"/>
								<TextBlock Text="Ingresos totales" FontSize="12" Foreground="#AAAAAA"/>
								<Border CornerRadius="99" Padding="8,3" Margin="0,10,0,0" HorizontalAlignment="Left">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="#2E7D32"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding VariacionPositiva}" Value="False">
													<Setter Property="Background" Value="#C62828"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<TextBlock Text="{Binding VariacionTexto}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
								</Border>
							</StackPanel>
						</Border>

						<!-- Nº facturas -->
						<Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20,18">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<Border Width="36" Height="36" CornerRadius="10"
                                        Background="#E3F2FD" HorizontalAlignment="Left" Margin="0,0,0,12">
									<materialDesign:PackIcon Kind="Receipt" Width="18" Height="18"
                                                             Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding TotalFacturas}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="Facturas emitidas" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
						</Border>

						<!-- Ticket medio -->
						<Border Grid.Column="4" Background="White" CornerRadius="14" Padding="20,18">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<Border Width="36" Height="36" CornerRadius="10"
                                        Background="#FFF3E0" HorizontalAlignment="Left" Margin="0,0,0,12">
									<materialDesign:PackIcon Kind="TagOutline" Width="18" Height="18"
                                                             Foreground="#EF6C00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding TicketMedioTexto}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="Ticket medio" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
						</Border>

						<!-- Clientes -->
						<Border Grid.Column="6" Background="White" CornerRadius="14" Padding="20,18">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<Border Width="36" Height="36" CornerRadius="10"
                                        Background="#F3E5F5" HorizontalAlignment="Left" Margin="0,0,0,12">
									<materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18"
                                                             Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding ClientesAtendidos}" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="Clientes atendidos" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
						</Border>

						<!-- Método top -->
						<Border Grid.Column="8" Background="White" CornerRadius="14" Padding="20,18">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<Border Width="36" Height="36" CornerRadius="10"
                                        Background="#E8F5E9" HorizontalAlignment="Left" Margin="0,0,0,12">
									<materialDesign:PackIcon Kind="CreditCard" Width="18" Height="18"
                                                             Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding MetodoPagoTop}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="Pago más usado" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
						</Border>
					</Grid>

					<!-- ══ FILA 2: Gráfica + Método de pago ══ -->
					<Grid Margin="0,0,0,16">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="2*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Gráfica de barras -->
						<Border Grid.Column="0" Background="White" CornerRadius="14" Padding="24">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<TextBlock Text="{Binding EtiquetaGrafica}" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>

								<!-- Barras -->
								<ItemsControl ItemsSource="{Binding PuntosGrafica}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="4,0" HorizontalAlignment="Center" Width="52">
												<!-- Valor encima -->
												<TextBlock Text="{Binding ValorTexto}" FontSize="10"
                                                           Foreground="{StaticResource TextLightBrush}"
                                                           HorizontalAlignment="Center" Margin="0,0,0,4"
                                                           TextTrimming="CharacterEllipsis"/>
												<!-- Barra + espacio vacío encima para alinear desde abajo -->
												<Grid Height="210" VerticalAlignment="Bottom">
													<Border VerticalAlignment="Bottom" CornerRadius="6,6,0,0"
                                                            Width="36" Height="{Binding Alto}">
														<Border.Background>
															<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
																<GradientStop Color="#D4A574" Offset="0"/>
																<GradientStop Color="#C9A86C" Offset="1"/>
															</LinearGradientBrush>
														</Border.Background>
													</Border>
												</Grid>
												<!-- Etiqueta debajo -->
												<TextBlock Text="{Binding Etiqueta}" FontSize="11"
                                                           Foreground="{StaticResource TextLightBrush}"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<!-- Desglose método de pago -->
						<Border Grid.Column="2" Background="White" CornerRadius="14" Padding="24">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<TextBlock Text="Por método de pago" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,20"/>

								<ItemsControl ItemsSource="{Binding DesglosePago}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,0,0,16">
												<Grid Margin="0,0,0,6">
													<Grid.ColumnDefinitions>
														<ColumnDefinition Width="*"/>
														<ColumnDefinition Width="Auto"/>
													</Grid.ColumnDefinitions>
													<TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"/>
													<TextBlock Grid.Column="1" Text="{Binding ImporteTexto}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBrush}"/>
												</Grid>
												<!-- Barra de progreso -->
												<Border Height="8" Background="{StaticResource LightGrayBrush}"
                                                        CornerRadius="4">
													<Border CornerRadius="4" HorizontalAlignment="Left">
														<Border.Width>
															<Binding Path="Porcentaje"/>
														</Border.Width>
														<Border.Background>
															<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
																<GradientStop Color="#D4A574" Offset="0"/>
																<GradientStop Color="#C9A86C" Offset="1"/>
															</LinearGradientBrush>
														</Border.Background>
													</Border>
												</Border>
												<TextBlock FontSize="11" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0">
													<Run Text="{Binding Cantidad}"/>
													<Run Text=" transacciones"/>
												</TextBlock>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</Grid>

					<!-- ══ FILA 3: Rankings ══ -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Top servicios -->
						<Border Grid.Column="0" Background="White" CornerRadius="14" Padding="24">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
									<materialDesign:PackIcon Kind="Scissors" Width="20" Height="20"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Text="Servicios más solicitados" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
								</StackPanel>

								<ItemsControl ItemsSource="{Binding ServiciosTop}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,0,0,14">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="28"/>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>

												<!-- Número posición -->
												<Border Grid.Column="0" Width="24" Height="24" CornerRadius="12">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Posicion}" Value="1">
																	<Setter Property="Background" Value="#D4A574"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Posicion}" Value="2">
																	<Setter Property="Background" Value="#B0BEC5"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Posicion}" Value="3">
																	<Setter Property="Background" Value="#BCAAA4"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="{Binding Posicion}" FontSize="11" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
												</Border>

												<!-- Nombre + barra -->
												<StackPanel Grid.Column="1" Margin="10,0">
													<Grid Margin="0,0,0,5">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>
														<TextBlock Text="{Binding Nombre}" FontSize="13"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
														<TextBlock Grid.Column="1" FontSize="12"
                                                                   Foreground="{StaticResource TextLightBrush}">
															<Run Text="{Binding Cantidad}"/>
															<Run Text=" veces"/>
														</TextBlock>
													</Grid>
													<Border Height="5" Background="{StaticResource LightGrayBrush}"
                                                            CornerRadius="3">
														<Border Height="5" CornerRadius="3" HorizontalAlignment="Left"
                                                                Background="{StaticResource AccentBrush}"
                                                                Width="{Binding Porcentaje}"/>
													</Border>
												</StackPanel>

												<!-- Importe -->
												<TextBlock Grid.Column="2" Text="{Binding ImporteTexto}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>

						<!-- Top clientes -->
						<Border Grid.Column="2" Background="White" CornerRadius="14" Padding="24">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
									<materialDesign:PackIcon Kind="AccountStar" Width="20" Height="20"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Text="Clientes con más gasto" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
								</StackPanel>

								<ItemsControl ItemsSource="{Binding ClientesTop}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,0,0,14">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="28"/>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>

												<Border Grid.Column="0" Width="24" Height="24" CornerRadius="12">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Posicion}" Value="1">
																	<Setter Property="Background" Value="#D4A574"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Posicion}" Value="2">
																	<Setter Property="Background" Value="#B0BEC5"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Posicion}" Value="3">
																	<Setter Property="Background" Value="#BCAAA4"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="{Binding Posicion}" FontSize="11" FontWeight="Bold"
                                                               Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
												</Border>

												<StackPanel Grid.Column="1" Margin="10,0">
													<Grid Margin="0,0,0,5">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>
														<TextBlock Text="{Binding Nombre}" FontSize="13"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
														<TextBlock Grid.Column="1" FontSize="12"
                                                                   Foreground="{StaticResource TextLightBrush}">
															<Run Text="{Binding Cantidad}"/>
															<Run Text=" visitas"/>
														</TextBlock>
													</Grid>
													<Border Height="5" Background="{StaticResource LightGrayBrush}"
                                                            CornerRadius="3">
														<Border Height="5" CornerRadius="3" HorizontalAlignment="Left"
                                                                Background="{StaticResource AccentBrush}"
                                                                Width="{Binding Porcentaje}"/>
													</Border>
												</StackPanel>

												<TextBlock Grid.Column="2" Text="{Binding ImporteTexto}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center"/>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</Grid>
					<!-- ══ FILA 4: Detalle de facturas ══ -->
					<Border Background="White" CornerRadius="14" Padding="24" Margin="0,16,0,16">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
						</Border.Effect>
						<StackPanel>

							<!-- Cabecera -->
							<Grid Margin="0,0,0,16">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto"/>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
									<materialDesign:PackIcon Kind="Receipt" Width="20" Height="20"
															 Foreground="{StaticResource AccentBrush}"
															 VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Text="Detalle de facturas" FontSize="15" FontWeight="SemiBold"
											   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
									<Border CornerRadius="99" Background="#FFF3E0" Padding="8,3" Margin="10,0,0,0"
											VerticalAlignment="Center">
										<TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}">
											<Run Text="{Binding TotalFacturas}"/>
											<Run Text=" registros"/>
										</TextBlock>
									</Border>
								</StackPanel>

								<!-- Buscador -->
								<Border Grid.Column="2" CornerRadius="8" BorderThickness="1"
										BorderBrush="{StaticResource LightGrayBrush}" Padding="10,6">
									<StackPanel Orientation="Horizontal">
										<materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
																 Foreground="{StaticResource TextLightBrush}"
																 VerticalAlignment="Center" Margin="0,0,6,0"/>
										<TextBox Text="{Binding FiltroBusqueda, UpdateSourceTrigger=PropertyChanged}"
												 Width="220" BorderThickness="0" Padding="0"
												 VerticalAlignment="Center" FontSize="13"
												 Foreground="{StaticResource TextBrush}"
												 materialDesign:HintAssist.Hint="Buscar por cliente, método, estado..."
												 Style="{StaticResource MaterialDesignTextBox}"/>
									</StackPanel>
								</Border>
							</Grid>

							<!-- DataGrid -->
							<DataGrid ItemsSource="{Binding FacturasFiltradas}"
									  AutoGenerateColumns="False"
									  IsReadOnly="True"
									  CanUserSortColumns="True"
									  GridLinesVisibility="Horizontal"
									  HorizontalGridLinesBrush="#F0F0F0"
									  HeadersVisibility="Column"
									  SelectionMode="Single"
									  Background="Transparent"
									  BorderThickness="0"
									  MaxHeight="400">

								<DataGrid.Resources>
									<!-- Estilo cabecera -->
									<Style x:Key="ColHeaderStyle" TargetType="DataGridColumnHeader">
										<Setter Property="Background"   Value="Transparent"/>
										<Setter Property="Foreground"   Value="{StaticResource TextLightBrush}"/>
										<Setter Property="FontSize"     Value="11"/>
										<Setter Property="FontWeight"   Value="SemiBold"/>
										<Setter Property="Padding"      Value="8,10"/>
										<Setter Property="BorderThickness" Value="0"/>
									</Style>
								</DataGrid.Resources>

								<!-- Estilo fila -->
								<DataGrid.RowStyle>
									<Style TargetType="DataGridRow">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="#FFF8F2"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</DataGrid.RowStyle>

								<!-- Estilo celda -->
								<DataGrid.CellStyle>
									<Style TargetType="DataGridCell">
										<Setter Property="BorderThickness" Value="0"/>
										<Setter Property="Padding"         Value="8,10"/>
										<Setter Property="Foreground"      Value="{StaticResource TextBrush}"/>
										<Setter Property="FontSize"        Value="13"/>
										<Setter Property="Background"      Value="Transparent"/>
										<Style.Triggers>
											<Trigger Property="IsSelected" Value="True">
												<Setter Property="Background" Value="#FFF3E0"/>
												<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</DataGrid.CellStyle>

								<DataGrid.Columns>
									<!-- Nº -->
									<DataGridTextColumn Header="Nº" Binding="{Binding Id}"
														Width="60" HeaderStyle="{StaticResource ColHeaderStyle}"/>
									<!-- Fecha -->
									<DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}"
														Width="110" HeaderStyle="{StaticResource ColHeaderStyle}"/>
									<!-- Cliente -->
									<DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}"
														Width="*" HeaderStyle="{StaticResource ColHeaderStyle}"/>
									<!-- Método -->
									<DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}"
														Width="110" HeaderStyle="{StaticResource ColHeaderStyle}"/>
									<!-- Subtotal -->
									<DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalTexto}"
														Width="100" HeaderStyle="{StaticResource ColHeaderStyle}"/>
									<!-- Descuento -->
									<DataGridTextColumn Header="Descuento" Binding="{Binding DescuentoTexto}"
														Width="100" HeaderStyle="{StaticResource ColHeaderStyle}"/>
									<!-- Total -->
									<DataGridTemplateColumn Header="Total" Width="110"
															HeaderStyle="{StaticResource ColHeaderStyle}"
															SortMemberPath="Total">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding TotalTexto}" FontWeight="SemiBold"
														   Foreground="{StaticResource AccentBrush}"
														   Padding="8,10" FontSize="13"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
									<!-- Estado -->
									<DataGridTemplateColumn Header="Estado" Width="100"
															HeaderStyle="{StaticResource ColHeaderStyle}"
															SortMemberPath="Estado">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="99" Padding="8,3" Margin="4,6"
														HorizontalAlignment="Left">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="#F5F5F5"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Estado}" Value="Pagada">
																	<Setter Property="Background" Value="#E8F5E9"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Estado}" Value="Pendiente">
																	<Setter Property="Background" Value="#FFF3E0"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Estado}" Value="Anulada">
																	<Setter Property="Background" Value="#FFEBEE"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="{Binding Estado}" FontSize="11" FontWeight="SemiBold">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Estado}" Value="Pagada">
																		<Setter Property="Foreground" Value="#2E7D32"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Estado}" Value="Pendiente">
																		<Setter Property="Foreground" Value="#EF6C00"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Estado}" Value="Anulada">
																		<Setter Property="Foreground" Value="#C62828"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>

						</StackPanel>
					</Border>
					<!-- FIN FILA 4 -->
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
