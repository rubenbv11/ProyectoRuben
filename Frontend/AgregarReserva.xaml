<Window x:Class="ProyectoRuben.Frontend.AgregarReserva"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="AgregarReserva_Loaded"
        Title="Nueva Reserva"
        Height="560" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7"
        WindowStyle="None"
        AllowsTransparency="True">

	<Border CornerRadius="16" ClipToBounds="True" Background="#F5F6F7">
		<Border.Effect>
			<DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270"
                              Color="#000000" Opacity="0.15"/>
		</Border.Effect>

		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="64"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- ═══ BARRA TÍTULO ═══ -->
			<Border Grid.Row="0" Background="#2D3436" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
				<Grid Margin="20,0">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<Border Width="32" Height="32" CornerRadius="8"
                                Background="#D4A574" Margin="0,0,12,0">
							<materialDesign:PackIcon Kind="CalendarPlus"
                                                     Width="18" Height="18"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
						</Border>
						<TextBlock Text="Nueva Reserva"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
					</StackPanel>
					<Button HorizontalAlignment="Right"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsCancel="True"
                            Click="Cancelar_Click">
						<materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="#AAAAAA"/>
					</Button>
				</Grid>
			</Border>

			<!-- ═══ CONTENIDO ═══ -->
			<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
				<StackPanel Margin="24,20,24,24">

					<!-- ── CLIENTE con búsqueda ── -->
					<TextBlock Text="CLIENTE" FontSize="11" FontWeight="SemiBold"
                               Foreground="#636E72" LetterSpacing="1"
                               Margin="0,0,0,6"/>

					<!-- Caja de búsqueda -->
					<Border Background="White" CornerRadius="8"
                            BorderBrush="#DFE6E9" BorderThickness="1"
                            Margin="0,0,0,4">
						<Grid>
							<materialDesign:PackIcon Kind="Magnify"
                                                     Width="16" Height="16"
                                                     Foreground="#B2BEC3"
                                                     Margin="12,0,0,0"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Left"/>
							<TextBox x:Name="TxtBuscarCliente"
                                     Margin="36,0,8,0"
                                     Height="40"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#2D3436"
                                     FontSize="14"
                                     VerticalContentAlignment="Center"
                                     TextChanged="TxtBuscarCliente_TextChanged"/>
							<TextBlock Text="Buscar cliente..."
                                       Foreground="#B2BEC3" FontSize="14"
                                       Margin="38,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding Text, ElementName=TxtBuscarCliente}" Value="">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Border>

					<!-- Lista filtrada de clientes -->
					<Border Background="White" CornerRadius="8"
                            BorderBrush="#DFE6E9" BorderThickness="1"
                            MaxHeight="160" Margin="0,0,0,16">
						<ListBox x:Name="ListaClientesFiltrada"
                                 ItemsSource="{Binding ClientesFiltrados}"
                                 SelectedItem="{Binding ClienteSeleccionado, Mode=TwoWay}"
                                 DisplayMemberPath="Nombre"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ListaClientes_SelectionChanged">
							<ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem">
									<Setter Property="Padding" Value="12,10"/>
									<Setter Property="FontSize" Value="13"/>
									<Setter Property="Foreground" Value="#2D3436"/>
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="BorderThickness" Value="0"/>
									<Setter Property="Cursor" Value="Hand"/>
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="#F5F6F7"/>
										</Trigger>
										<Trigger Property="IsSelected" Value="True">
											<Setter Property="Background" Value="#FFF4EC"/>
											<Setter Property="Foreground" Value="#D4A574"/>
											<Setter Property="FontWeight" Value="SemiBold"/>
										</Trigger>
									</Style.Triggers>
								</Style>
							</ListBox.ItemContainerStyle>
						</ListBox>
					</Border>

					<!-- Cliente seleccionado (chip) -->
					<Border x:Name="ChipCliente"
                            Background="#FFF4EC" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,16"
                            Visibility="Collapsed">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Border Grid.Column="0" Width="28" Height="28"
                                    CornerRadius="14" Background="#D4A574"
                                    Margin="0,0,10,0">
								<TextBlock x:Name="TxtInicialCliente"
                                           Foreground="White" FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
							</Border>
							<TextBlock x:Name="TxtNombreClienteSeleccionado"
                                       Grid.Column="1"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#2D3436"
                                       VerticalAlignment="Center"/>
							<Button Grid.Column="2"
                                    Width="24" Height="24"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="LimpiarCliente_Click">
								<materialDesign:PackIcon Kind="Close"
                                                         Width="14" Height="14"
                                                         Foreground="#636E72"/>
							</Button>
						</Grid>
					</Border>

					<!-- ── SERVICIO ── -->
					<TextBlock Text="SERVICIO" FontSize="11" FontWeight="SemiBold"
                               Foreground="#636E72" Margin="0,0,0,6"/>
					<Border Background="White" CornerRadius="8"
                            BorderBrush="#DFE6E9" BorderThickness="1"
                            Margin="0,0,0,16">
						<ComboBox ItemsSource="{Binding ListaServicios}"
                                  SelectedItem="{Binding ServicioSeleccionado, Mode=TwoWay}"
                                  DisplayMemberPath="Nombre"
                                  Height="42"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Foreground="#2D3436"
                                  FontSize="13"
                                  Padding="12,0"
                                  VerticalContentAlignment="Center">
							<ComboBox.ItemContainerStyle>
								<Style TargetType="ComboBoxItem">
									<Setter Property="Padding" Value="12,10"/>
									<Setter Property="FontSize" Value="13"/>
									<Setter Property="Foreground" Value="#2D3436"/>
								</Style>
							</ComboBox.ItemContainerStyle>
						</ComboBox>
					</Border>

					<!-- ── FECHA Y HORA en dos columnas ── -->
					<Grid Margin="0,0,0,24">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="16"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Fecha -->
						<StackPanel Grid.Column="0">
							<TextBlock Text="FECHA" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#636E72" Margin="0,0,0,6"/>
							<Border Background="White" CornerRadius="8"
                                    BorderBrush="#DFE6E9" BorderThickness="1">
								<DatePicker x:Name="DatePickerReserva"
                                            SelectedDate="{Binding FechaReserva, Mode=TwoWay}"
                                            Height="42"
                                            BorderThickness="0"
                                            Background="Transparent"
                                            Foreground="#2D3436"
                                            FontSize="13"
                                            Padding="8,0"
                                            VerticalContentAlignment="Center"
                                            CalendarStyle="{StaticResource NeutroCalendarStyle}"/>
							</Border>
						</StackPanel>

						<!-- Hora: HH y MM con spinners nativos -->
						<StackPanel Grid.Column="2">
							<TextBlock Text="HORA" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#636E72" Margin="0,0,0,6"/>
							<Border Background="White" CornerRadius="8"
                                    BorderBrush="#DFE6E9" BorderThickness="1"
                                    Height="42">
								<Grid VerticalAlignment="Center" Margin="8,0">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>

									<!-- Horas -->
									<TextBox x:Name="TxtHora"
                                             Grid.Column="0"
                                             Text="{Binding HoraHH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="2"
                                             TextAlignment="Center"
                                             FontSize="15" FontWeight="SemiBold"
                                             Foreground="#2D3436"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             PreviewTextInput="SoloNumeros_PreviewTextInput"/>

									<TextBlock Grid.Column="1" Text=":"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="#636E72"
                                               VerticalAlignment="Center"/>

									<!-- Minutos -->
									<TextBox x:Name="TxtMinutos"
                                             Grid.Column="2"
                                             Text="{Binding HoraMM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="2"
                                             TextAlignment="Center"
                                             FontSize="15" FontWeight="SemiBold"
                                             Foreground="#2D3436"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             PreviewTextInput="SoloNumeros_PreviewTextInput"/>
								</Grid>
							</Border>
							<TextBlock Text="Formato 24h  ej: 09 : 30"
                                       FontSize="10" Foreground="#B2BEC3"
                                       Margin="2,4,0,0"/>
						</StackPanel>
					</Grid>

					<!-- ── BOTONES ── -->
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<Button Grid.Column="0"
                                Content="Cancelar"
                                Height="44"
                                Background="#F5F6F7"
                                Foreground="#636E72"
                                FontSize="14" FontWeight="SemiBold"
                                BorderThickness="1" BorderBrush="#DFE6E9"
                                Cursor="Hand"
                                IsCancel="True"
                                Click="Cancelar_Click">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border CornerRadius="8"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
										<ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>

						<Button Grid.Column="2"
                                Content="Guardar Reserva"
                                Height="44"
                                Background="#D4A574"
                                Foreground="White"
                                FontSize="14" FontWeight="SemiBold"
                                BorderThickness="0"
                                Cursor="Hand"
                                IsDefault="True"
                                Click="Guardar_Click">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border CornerRadius="8"
                                            Background="{TemplateBinding Background}">
										<ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
									</Border>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</Grid>

				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Border>
</Window>
