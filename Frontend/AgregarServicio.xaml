<Window x:Class="ProyectoRuben.Frontend.AgregarServicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Loaded="AgregarServicio_Loaded"
        Title="Servicio"
        Height="540" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="16" ClipToBounds="True" Background="#F5F6F7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270"
                              Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ BARRA TÍTULO ═══ -->
            <Border Grid.Row="0" Background="#2D3436" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="#D4A574" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="Scissors"
                                                     Width="18" Height="18"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TxtTituloVentana"
                                   Text="Nuevo Servicio"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Width="32" Height="32"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" IsCancel="True" Click="Cancelar_Click">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="#AAAAAA"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ CONTENIDO ═══ -->
            <StackPanel Grid.Row="1" Margin="28,20,28,24">

                <!-- NOMBRE -->
                <TextBlock Text="NOMBRE" FontSize="11" FontWeight="SemiBold"
                           Foreground="#636E72" Margin="0,0,0,6"/>
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#DFE6E9" BorderThickness="1" Margin="0,0,0,16">
                    <TextBox x:Name="TxtNombre"
                             Text="{Binding ServicioNuevo.Nombre, UpdateSourceTrigger=PropertyChanged}"
                             Height="42" BorderThickness="0"
                             Background="Transparent" Foreground="#2D3436"
                             FontSize="14" Padding="12,0" VerticalContentAlignment="Center">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Border>

                <!-- DESCRIPCIÓN -->
                <TextBlock Text="DESCRIPCIÓN" FontSize="11" FontWeight="SemiBold"
                           Foreground="#636E72" Margin="0,0,0,6"/>
                <Border Background="White" CornerRadius="8"
                        BorderBrush="#DFE6E9" BorderThickness="1" Margin="0,0,0,16">
                    <TextBox x:Name="TxtDescripcion"
                             Text="{Binding ServicioNuevo.Descripcion, UpdateSourceTrigger=PropertyChanged}"
                             Height="70" BorderThickness="0"
                             Background="Transparent" Foreground="#2D3436"
                             FontSize="14" Padding="12,10"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                </Border>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Border>

                <!-- DURACIÓN Y PRECIO en dos columnas -->
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Duración -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DURACIÓN (MINUTOS)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#636E72" Margin="0,0,0,6"/>
                        <Border Background="White" CornerRadius="8"
                                BorderBrush="#DFE6E9" BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="TxtDuracion"
                                         Text="{Binding ServicioNuevo.Duracion, UpdateSourceTrigger=PropertyChanged}"
                                         Height="42" BorderThickness="0"
                                         Background="Transparent" Foreground="#2D3436"
                                         FontSize="14" Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         PreviewTextInput="SoloNumeros_PreviewTextInput">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock Text="min" FontSize="12"
                                           Foreground="#636E72"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Precio -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PRECIO (€)" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#636E72" Margin="0,0,0,6"/>
                        <Border Background="White" CornerRadius="8"
                                BorderBrush="#DFE6E9" BorderThickness="1">
                            <Grid>
                                <TextBox x:Name="TxtPrecio"
                                         Text="{Binding ServicioNuevo.Costo, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                         Height="42" BorderThickness="0"
                                         Background="Transparent" Foreground="#2D3436"
                                         FontSize="14" Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         PreviewTextInput="SoloDecimales_PreviewTextInput">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock Text="€" FontSize="12"
                                           Foreground="#636E72"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- BOTONES -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancelar"
                            Height="44" Background="#F5F6F7"
                            Foreground="#636E72" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="1" BorderBrush="#DFE6E9"
                            Cursor="Hand" IsCancel="True" Click="Cancelar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2"
                            x:Name="BtnGuardar"
                            Content="Guardar"
                            Height="44" Background="#D4A574"
                            Foreground="White" FontSize="14" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            IsDefault="True" Click="Guardar_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </StackPanel>
        </Grid>
    </Border>
</Window>
