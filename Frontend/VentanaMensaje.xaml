<Window x:Class="ProyectoRuben.Frontend.VentanaMensaje"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Información" Height="200" Width="350"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

	<Border Background="White" CornerRadius="12" Margin="10">
		<Border.Effect>
			<DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2"/>
		</Border.Effect>

		<Grid Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
				<materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource AccentBrush}" Width="28" Height="28"/>
				<TextBlock x:Name="txtTitulo" Text="Información" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
			</StackPanel>

			<TextBlock Grid.Row="1" x:Name="txtMensaje" Text="Selecciona una hora."
                       FontSize="15" Foreground="#666666" TextWrapping="Wrap" VerticalAlignment="Center"/>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
				<Button Content="Aceptar" Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                        Foreground="White" Width="100" Click="BtnAceptar_Click"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>