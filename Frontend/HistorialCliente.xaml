<Window x:Class="ProyectoRuben.Frontend.HistorialCliente"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Historial de Citas"
        Height="560" Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F6F7"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="16" ClipToBounds="True" Background="#F5F6F7">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Direction="270"
                              Color="#000000" Opacity="0.15"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ BARRA TÍTULO ═══ -->
            <Border Grid.Row="0" Background="#2D3436" CornerRadius="16,16,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8"
                                Background="#D4A574" Margin="0,0,12,0">
                            <materialDesign:PackIcon Kind="History"
                                                     Width="18" Height="18"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNombreCliente"
                                       Text="Historial de citas"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="White"/>
                            <TextBlock x:Name="TxtSubtitulo"
                                       Text="..."
                                       FontSize="11" Foreground="#AAAAAA"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Width="32" Height="32"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Click="Cerrar_Click">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Foreground="#AAAAAA"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ═══ RESUMEN STATS ═══ -->
            <Border Grid.Row="1" Background="White"
                    BorderBrush="#DFE6E9" BorderThickness="0,0,0,1"
                    Padding="24,14">
                <StackPanel Orientation="Horizontal">
                    <!-- Total citas -->
                    <Border Background="#F5F6F7" CornerRadius="8" Padding="16,10" Margin="0,0,12,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtTotalCitas"
                                       Text="0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="#2D3436" HorizontalAlignment="Center"/>
                            <TextBlock Text="citas totales" FontSize="11"
                                       Foreground="#636E72" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Completadas -->
                    <Border Background="#E8F5E9" CornerRadius="8" Padding="16,10" Margin="0,0,12,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtCompletadas"
                                       Text="0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="#2E7D32" HorizontalAlignment="Center"/>
                            <TextBlock Text="completadas" FontSize="11"
                                       Foreground="#2E7D32" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Pendientes -->
                    <Border Background="#FFF3E0" CornerRadius="8" Padding="16,10" Margin="0,0,12,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtPendientes"
                                       Text="0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="#EF6C00" HorizontalAlignment="Center"/>
                            <TextBlock Text="pendientes" FontSize="11"
                                       Foreground="#EF6C00" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <!-- Canceladas -->
                    <Border Background="#FFEBEE" CornerRadius="8" Padding="16,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="TxtCanceladas"
                                       Text="0" FontSize="22" FontWeight="SemiBold"
                                       Foreground="#C62828" HorizontalAlignment="Center"/>
                            <TextBlock Text="canceladas" FontSize="11"
                                       Foreground="#C62828" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ LISTA DE CITAS ═══ -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Padding="20,16,20,8">
                <StackPanel>
                    <!-- Estado vacío -->
                    <StackPanel x:Name="PanelVacio"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0,60,0,0" Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="CalendarBlankOutline"
                                                 Width="48" Height="48"
                                                 Foreground="#DFE6E9"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,12"/>
                        <TextBlock Text="Sin citas registradas"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="#636E72" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Filas de citas -->
                    <ItemsControl x:Name="ListaCitas">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="10"
                                        Padding="18,14" Margin="0,0,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                                          Direction="270" Color="#000000"
                                                          Opacity="0.05"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Fecha -->
                                        <Border Grid.Column="0"
                                                Width="52" Height="52"
                                                Background="#F5F6F7"
                                                CornerRadius="10"
                                                Margin="0,0,16,0">
                                            <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding Dia}"
                                                           FontSize="18" FontWeight="SemiBold"
                                                           Foreground="#2D3436"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding Mes}"
                                                           FontSize="10"
                                                           Foreground="#636E72"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Servicio + hora -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Servicio}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="#2D3436"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <materialDesign:PackIcon Kind="ClockOutline"
                                                                         Width="13" Height="13"
                                                                         Foreground="#636E72"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding Hora}"
                                                           FontSize="12"
                                                           Foreground="#636E72"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text=" · " FontSize="12"
                                                           Foreground="#DFE6E9"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Empleado}"
                                                           FontSize="12"
                                                           Foreground="#636E72"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Badge estado -->
                                        <Border Grid.Column="2"
                                                CornerRadius="99"
                                                Padding="12,5"
                                                VerticalAlignment="Center"
                                                Background="{Binding ColorEstado}">
                                            <TextBlock Text="{Binding Estado}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding TextoEstado}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ PIE ═══ -->
            <Border Grid.Row="3" Background="White"
                    BorderBrush="#DFE6E9" BorderThickness="0,1,0,0"
                    Padding="24,16">
                <Button Content="Cerrar"
                        Height="40" Width="120"
                        HorizontalAlignment="Right"
                        Background="#D4A574" Foreground="White"
                        FontSize="14" FontWeight="SemiBold"
                        BorderThickness="0" Cursor="Hand"
                        Click="Cerrar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="8" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
