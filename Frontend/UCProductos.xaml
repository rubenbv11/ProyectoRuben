<UserControl x:Class="ProyectoRuben.Frontend.UCProductos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ ENCABEZADO ══ -->
		<Border Grid.Row="0" Background="White" Padding="32,24"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Catálogo de Productos" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Gestiona el inventario y stock de productos"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0"/>
				</StackPanel>
				<Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                        Foreground="White" Height="40" Padding="16,0" Cursor="Hand"
                        Command="{Binding AgregarProductoCommand}"
                        Visibility="{Binding MostrandoActivos, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
						<TextBlock Text="Nuevo Producto" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!-- ══ TABS + BÚSQUEDA ══ -->
		<Border Grid.Row="1" Background="White" Padding="32,12"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="360"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Tabs Activos / Archivados -->
				<Border Grid.Column="0" Background="{StaticResource LightGrayBrush}"
                        CornerRadius="8" Padding="4">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding MostrarActivosCommand}"
                                Height="32" Padding="16,0" BorderThickness="0" Cursor="Hand">
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="Button">
												<Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding MostrandoActivos}" Value="True">
											<Setter Property="Background" Value="White"/>
											<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<TextBlock Text="Activos" FontSize="13" FontWeight="SemiBold"/>
						</Button>
						<Button Command="{Binding MostrarArchivadosCommand}"
                                Height="32" Padding="16,0" BorderThickness="0" Cursor="Hand">
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="Button">
												<Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding MostrandoArchivados}" Value="True">
											<Setter Property="Background" Value="White"/>
											<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<TextBlock Text="Archivados" FontSize="13" FontWeight="SemiBold"/>
						</Button>
					</StackPanel>
				</Border>

				<!-- Buscador -->
				<Border Grid.Column="2" Background="{StaticResource LightGrayBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1">
					<Grid>
						<materialDesign:PackIcon Kind="Magnify" Foreground="{StaticResource TextLightBrush}"
                                                 Width="18" Height="18" Margin="12,0,0,0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Left"/>
						<TextBox Text="{Binding FiltroNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="36,0,10,0" Height="36" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                                 FontSize="13" VerticalContentAlignment="Center">
							<TextBox.Template>
								<ControlTemplate TargetType="TextBox">
									<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
								</ControlTemplate>
							</TextBox.Template>
						</TextBox>
						<TextBlock Text="Buscar por nombre..." Foreground="{StaticResource TextLightBrush}"
                                   FontSize="13" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
				</Border>

				<!-- Stats -->
				<StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,0,16,0">
						<Run Text="{Binding TotalProductos}"/>
						<Run Text="productos"/>
					</TextBlock>
					<Border Background="#FFEBEE" CornerRadius="99" Padding="10,4"
                            Visibility="{Binding HayStockBajo, Converter={StaticResource BooleanToVisibilityConverter}}">
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                     Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,5,0"/>
							<TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#C62828">
								<Run Text="{Binding TotalStockBajo}"/>
								<Run Text="con stock bajo"/>
							</TextBlock>
						</StackPanel>
					</Border>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENIDO ══ -->
		<Grid Grid.Row="2">
			<!-- Estado vacío -->
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource MediumGrayBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
					<materialDesign:PackIcon Kind="Package" Foreground="White" Width="36" Height="36"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
				<TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Text" Value="Sin productos registrados"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding MostrandoArchivados}" Value="True">
									<Setter Property="Text" Value="Sin productos archivados"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>

			<!-- Cards 2 columnas -->
			<ScrollViewer Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding ListaProductosView}" Padding="28,20,28,28">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="2"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,10,10" Background="White" CornerRadius="12" Padding="16,14">
								<Border.Effect>
									<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
								</Border.Effect>
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="BorderThickness" Value="3,0,0,0"/>
										<Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding AlertaStock}" Value="True">
												<Setter Property="BorderBrush" Value="#D63031"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>

								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<!-- Fila superior -->
									<Grid Grid.Row="0" Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Margin="0,0,12,0">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding AlertaStock}" Value="True">
															<Setter Property="Background" Value="#FFEBEE"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<materialDesign:PackIcon Kind="Package" Width="20" Height="20"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
												<materialDesign:PackIcon.Style>
													<Style TargetType="materialDesign:PackIcon">
														<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding AlertaStock}" Value="True">
																<Setter Property="Foreground" Value="#D63031"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</materialDesign:PackIcon.Style>
											</materialDesign:PackIcon>
										</Border>
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="{Binding Nombre}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding Proveedor}" FontSize="12"
                                                       Foreground="{StaticResource TextLightBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
										</StackPanel>
										<TextBlock Grid.Column="2" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="12,0,0,0">
											<Run Text="{Binding Precio, StringFormat='{}{0:F2}'}"/>
											<Run Text=" €"/>
										</TextBlock>
									</Grid>

									<!-- Fila inferior: badge + botones -->
									<Grid Grid.Row="1">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Badge stock -->
										<Border Grid.Column="0" CornerRadius="99" Padding="10,4"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Background" Value="#E8F5E9"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding AlertaStock}" Value="True">
															<Setter Property="Background" Value="#FFEBEE"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0">
													<materialDesign:PackIcon.Style>
														<Style TargetType="materialDesign:PackIcon">
															<Setter Property="Kind" Value="PackageVariant"/>
															<Setter Property="Foreground" Value="#2E7D32"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding AlertaStock}" Value="True">
																	<Setter Property="Kind" Value="AlertOutline"/>
																	<Setter Property="Foreground" Value="#C62828"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</materialDesign:PackIcon.Style>
												</materialDesign:PackIcon>
												<TextBlock FontSize="12" FontWeight="SemiBold">
													<TextBlock.Style>
														<Style TargetType="TextBlock">
															<Setter Property="Foreground" Value="#2E7D32"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding AlertaStock}" Value="True">
																	<Setter Property="Foreground" Value="#C62828"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</TextBlock.Style>
													<Run Text="{Binding Cantidad}"/>
													<Run Text=" uds"/>
												</TextBlock>
												<TextBlock Text=" · Stock bajo" FontSize="12" FontWeight="SemiBold" Foreground="#C62828"
                                                           Visibility="{Binding AlertaStock, Converter={StaticResource BooleanToVisibilityConverter}}"/>
											</StackPanel>
										</Border>

										<!-- Botones: cambian según Activos/Archivados -->
										<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

											<!-- Editar (solo en Activos) -->
											<Button Width="32" Height="32" Background="Transparent"
                                                    BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                                                    Cursor="Hand" Margin="0,0,6,0" ToolTip="Editar producto"
                                                    Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" Foreground="{StaticResource TextLightBrush}"/>
											</Button>

											<!-- Archivar (solo en Activos) -->
											<Button Width="32" Height="32" Background="#FFF0F0"
                                                    BorderThickness="1" BorderBrush="#FFCDD2"
                                                    Cursor="Hand" ToolTip="Archivar producto"
                                                    Command="{Binding DataContext.DesactivarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="ArchiveArrowDown" Width="15" Height="15" Foreground="#D63031"/>
											</Button>

											<!-- Reactivar (solo en Archivados) -->
											<Button Width="32" Height="32" Background="#E8F5E9"
                                                    BorderThickness="1" BorderBrush="#C8E6C9"
                                                    Cursor="Hand" ToolTip="Reactivar producto"
                                                    Command="{Binding DataContext.ReactivarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Visibility="{Binding DataContext.MostrandoArchivados, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="Restore" Width="15" Height="15" Foreground="#2E7D32"/>
											</Button>
										</StackPanel>
									</Grid>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
