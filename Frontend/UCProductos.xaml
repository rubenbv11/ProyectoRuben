<UserControl x:Class="ProyectoRuben.Frontend.UCProductos"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ENCABEZADO -->
		<Border Grid.Row="0" Background="White" Padding="32,24"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Catálogo de Productos" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Gestiona el inventario y stock de productos"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0"/>
				</StackPanel>
				<Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                        Foreground="White" Height="40" Padding="16,0" Cursor="Hand"
                        Command="{Binding AgregarProductoCommand}"
                        Visibility="{Binding MostrandoActivos, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
						<TextBlock Text="Nuevo Producto" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!-- TABS + BUSQUEDA -->
		<Border Grid.Row="1" Background="White" Padding="32,12"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Button Grid.Column="0" Content="Activos" Height="34" Padding="16,0" Cursor="Hand"
                        Command="{Binding MostrarActivosCommand}">
					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
							<Setter Property="Foreground" Value="White"/>
							<Setter Property="BorderThickness" Value="0"/>
							<Setter Property="FontSize" Value="13"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
											<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<DataTrigger Binding="{Binding MostrandoActivos}" Value="False">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
									<Setter Property="BorderThickness" Value="1"/>
									<Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>

				<Button Grid.Column="2" Content="Archivados" Height="34" Padding="16,0" Cursor="Hand"
                        Command="{Binding MostrarArchivadosCommand}">
					<Button.Style>
						<Style TargetType="Button">
							<Setter Property="Background" Value="Transparent"/>
							<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
							<Setter Property="BorderThickness" Value="1"/>
							<Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
							<Setter Property="FontSize" Value="13"/>
							<Setter Property="FontWeight" Value="SemiBold"/>
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="Button">
										<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
											<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
										</Border>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
							<Style.Triggers>
								<DataTrigger Binding="{Binding MostrandoArchivados}" Value="True">
									<Setter Property="Background" Value="{StaticResource AccentBrush}"/>
									<Setter Property="Foreground" Value="White"/>
									<Setter Property="BorderThickness" Value="0"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>

				<Border Grid.Column="3" CornerRadius="8" BorderThickness="1" Margin="16,0,0,0"
                        BorderBrush="{StaticResource MediumGrayBrush}" Padding="10,0" Height="34">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
                                                 Foreground="{StaticResource TextLightBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
						<TextBox Text="{Binding FiltroNombre, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" VerticalAlignment="Center" FontSize="13"
                                 Foreground="{StaticResource TextBrush}"
                                 materialDesign:HintAssist.Hint="Buscar producto..."
                                 Style="{StaticResource MaterialDesignTextBox}"/>
					</StackPanel>
				</Border>

				<Border Grid.Column="4" CornerRadius="8" Background="#FFEBEE" Padding="10,6" Margin="12,0,0,0"
                        Visibility="{Binding HayStockBajo, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                 Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,5,0"/>
						<TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#C62828">
							<Run Text="{Binding TotalStockBajo}"/>
							<Run Text=" con stock bajo"/>
						</TextBlock>
					</StackPanel>
				</Border>
			</Grid>
		</Border>

		<!-- CONTENIDO -->
		<Grid Grid.Row="2">
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource MediumGrayBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
					<materialDesign:PackIcon Kind="Package" Foreground="White" Width="36" Height="36"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
				<TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Text" Value="Sin productos registrados"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding MostrandoArchivados}" Value="True">
									<Setter Property="Text" Value="Sin productos archivados"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>

			<ScrollViewer Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding ListaProductosView}" Padding="28,20,28,28">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="2"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,10,10" Background="White" CornerRadius="12" Padding="16,14">
								<Border.Effect>
									<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
								</Border.Effect>
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="BorderThickness" Value="0"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding AlertaStock}" Value="True">
												<Setter Property="BorderThickness" Value="1.5"/>
												<Setter Property="BorderBrush" Value="#FFCDD2"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>

								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<!-- FILA 1: nombre + botones CRUD -->
									<Grid Grid.Row="0" Margin="0,0,0,10">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>
										<StackPanel Grid.Column="0">
											<TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding Proveedor}" FontSize="12"
                                                       Foreground="{StaticResource TextLightBrush}" Margin="0,2,0,0"/>
										</StackPanel>
										<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
											<Button Width="32" Height="32" Background="Transparent"
                                                    BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                                                    Cursor="Hand" Margin="0,0,6,0" ToolTip="Editar producto"
                                                    Command="{Binding DataContext.EditarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" Foreground="{StaticResource TextLightBrush}"/>
											</Button>
											<Button Width="32" Height="32" Background="#FFF0F0"
                                                    BorderThickness="1" BorderBrush="#FFCDD2"
                                                    Cursor="Hand" ToolTip="Archivar producto"
                                                    Command="{Binding DataContext.DesactivarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="ArchiveArrowDown" Width="15" Height="15" Foreground="#D63031"/>
											</Button>
											<Button Width="32" Height="32" Background="#E8F5E9"
                                                    BorderThickness="1" BorderBrush="#C8E6C9"
                                                    Cursor="Hand" ToolTip="Reactivar producto"
                                                    Command="{Binding DataContext.ReactivarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"
                                                    Visibility="{Binding DataContext.MostrandoArchivados, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="Restore" Width="15" Height="15" Foreground="#2E7D32"/>
											</Button>
										</StackPanel>
									</Grid>

									<!-- FILA 2: precio + badge stock bajo -->
									<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
										<Border CornerRadius="6" Background="#FFF3E0" Padding="8,3" Margin="0,0,8,0">
											<TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                       Text="{Binding Precio, StringFormat='{}{0:F2} €'}"/>
										</Border>
										<Border CornerRadius="6" Background="#FFEBEE" Padding="8,3"
                                                Visibility="{Binding AlertaStock, Converter={StaticResource BooleanToVisibilityConverter}}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="AlertCircle" Width="12" Height="12"
                                                                         Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,4,0"/>
												<TextBlock Text="Stock bajo" FontSize="11" FontWeight="SemiBold" Foreground="#C62828"/>
											</StackPanel>
										</Border>
									</StackPanel>

									<!-- FILA 3: control stock inline (solo Activos) -->
									<Border Grid.Row="2" Background="{StaticResource LightGrayBrush}" CornerRadius="10" Padding="12,8"
                                            Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
												<materialDesign:PackIcon Kind="PackageVariant" Width="14" Height="14"
                                                                         Foreground="{StaticResource TextLightBrush}"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
												<TextBlock FontSize="12" Foreground="{StaticResource TextLightBrush}"
                                                           VerticalAlignment="Center" Text="Stock: "/>
												<TextBlock FontSize="13" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center">
													<TextBlock.Style>
														<Style TargetType="TextBlock">
															<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding AlertaStock}" Value="True">
																	<Setter Property="Foreground" Value="#C62828"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</TextBlock.Style>
													<Run Text="{Binding Cantidad, Mode=OneWay}"/>
													<Run Text=" uds"/>
												</TextBlock>
											</StackPanel>

											<!-- Botones − / + : Tag pasa el Producto al code-behind -->
											<StackPanel Grid.Column="1" Orientation="Horizontal">
												<Button Width="28" Height="28" Background="White"
                                                        BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                                                        Cursor="Hand" Margin="0,0,6,0" ToolTip="Reducir stock"
                                                        Tag="{Binding}" Click="BtnMenos_Click">
													<Button.Template>
														<ControlTemplate TargetType="Button">
															<Border CornerRadius="7" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
																<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
															</Border>
														</ControlTemplate>
													</Button.Template>
													<materialDesign:PackIcon Kind="Minus" Width="13" Height="13" Foreground="{StaticResource TextBrush}"/>
												</Button>
												<Button Width="28" Height="28" Background="{StaticResource AccentBrush}"
                                                        BorderThickness="0" Cursor="Hand" ToolTip="Aumentar stock"
                                                        Tag="{Binding}" Click="BtnMas_Click">
													<Button.Template>
														<ControlTemplate TargetType="Button">
															<Border CornerRadius="7" Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
																<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
															</Border>
														</ControlTemplate>
													</Button.Template>
													<materialDesign:PackIcon Kind="Plus" Width="13" Height="13" Foreground="White"/>
												</Button>
											</StackPanel>
										</Grid>
									</Border>

								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
