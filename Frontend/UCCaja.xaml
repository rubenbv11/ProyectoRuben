<UserControl x:Class="ProyectoRuben.Frontend.UCCaja"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.ColumnDefinitions>
			<!-- Catálogo -->
			<ColumnDefinition Width="320"/>
			<!-- Ticket -->
			<ColumnDefinition Width="*"/>
			<!-- Pago -->
			<ColumnDefinition Width="300"/>
		</Grid.ColumnDefinitions>

		<!-- ══════════════════════════════════════════════════════════════════
             COLUMNA 1 — CATÁLOGO (servicios / productos)
        ══════════════════════════════════════════════════════════════════ -->
		<Grid Grid.Column="0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Cabecera catálogo -->
			<Border Grid.Row="0" Background="#2D3436" Padding="20,16">
				<StackPanel>
					<TextBlock Text="CATÁLOGO" FontSize="11" FontWeight="Bold"
                               Foreground="#AAAAAA" Margin="0,0,0,4"/>
					<TextBlock Text="Servicios y Productos" FontSize="17" FontWeight="SemiBold"
                               Foreground="White"/>
				</StackPanel>
			</Border>

			<!-- Tabs Servicios / Productos -->
			<Border Grid.Row="1" Background="#2D3436" Padding="12,0,12,12">
				<Border Background="#1A2426" CornerRadius="8" Padding="4">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>
						<Button Grid.Column="0" Command="{Binding MostrarServiciosCommand}"
                                Height="32" BorderThickness="0" Cursor="Hand">
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="#888888"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="Button">
												<Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding PanelServicios}" Value="True">
											<Setter Property="Background" Value="#D4A574"/>
											<Setter Property="Foreground" Value="White"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Kind="Scissors" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
								<TextBlock Text="Servicios" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
						<Button Grid.Column="1" Command="{Binding MostrarProductosCommand}"
                                Height="32" BorderThickness="0" Cursor="Hand">
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="#888888"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="Button">
												<Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding PanelProductos}" Value="True">
											<Setter Property="Background" Value="#D4A574"/>
											<Setter Property="Foreground" Value="White"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<StackPanel Orientation="Horizontal">
								<materialDesign:PackIcon Kind="Package" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
								<TextBlock Text="Productos" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</Grid>
				</Border>
			</Border>

			<!-- Buscador catálogo -->
			<Border Grid.Row="2" Background="White" Padding="12,10"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
				<Grid>
					<!-- Buscador Servicios -->
					<Border Visibility="{Binding PanelServicios, Converter={StaticResource BooleanToVisibilityConverter}}"
							Background="{StaticResource LightGrayBrush}" CornerRadius="8"
							BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1">
						<Grid>
							<materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
													 Foreground="{StaticResource TextLightBrush}"
													 Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
							<TextBox Text="{Binding BusquedaServicio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 Margin="30,0,8,0" Height="34" BorderThickness="0"
									 Background="Transparent" FontSize="13" VerticalContentAlignment="Center">
								<TextBox.Template>
									<ControlTemplate TargetType="TextBox">
										<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
									</ControlTemplate>
								</TextBox.Template>
							</TextBox>
							<TextBlock Text="Buscar servicio..." FontSize="12"
									   Foreground="{StaticResource TextLightBrush}" Margin="32,0,0,0"
									   VerticalAlignment="Center" IsHitTestVisible="False">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding BusquedaServicio}" Value="">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
											<DataTrigger Binding="{Binding BusquedaServicio}" Value="{x:Null}">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Border>
					<!-- Buscador Productos -->
					<Border Visibility="{Binding PanelProductos, Converter={StaticResource BooleanToVisibilityConverter}}"
							Background="{StaticResource LightGrayBrush}" CornerRadius="8"
							BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1">
						<Grid>
							<materialDesign:PackIcon Kind="Magnify" Width="16" Height="16"
													 Foreground="{StaticResource TextLightBrush}"
													 Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
							<TextBox Text="{Binding BusquedaProducto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									 Margin="30,0,8,0" Height="34" BorderThickness="0"
									 Background="Transparent" FontSize="13" VerticalContentAlignment="Center">
								<TextBox.Template>
									<ControlTemplate TargetType="TextBox">
										<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
									</ControlTemplate>
								</TextBox.Template>
							</TextBox>
							<TextBlock Text="Buscar producto..." FontSize="12"
									   Foreground="{StaticResource TextLightBrush}" Margin="32,0,0,0"
									   VerticalAlignment="Center" IsHitTestVisible="False">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Visibility" Value="Collapsed"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding BusquedaProducto}" Value="">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
											<DataTrigger Binding="{Binding BusquedaProducto}" Value="{x:Null}">
												<Setter Property="Visibility" Value="Visible"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
						</Grid>
					</Border>
				</Grid>
			</Border>

			<!-- Lista catálogo -->
			<Grid Grid.Row="3" Background="#F2F2F2">
				<!-- Servicios agrupados por categoría -->
				<ScrollViewer Visibility="{Binding PanelServicios, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding GruposServicios}" Padding="8,6">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<!-- Grupo / categoría -->
								<Border Margin="0,0,0,6">
									<StackPanel>
										<!-- Cabecera del grupo clicable -->
										<Border Background="#2D3436" CornerRadius="8" Margin="0,0,0,2"
												Cursor="Hand" MinHeight="38">
											<Border.InputBindings>
												<MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
											</Border.InputBindings>
											<Grid Margin="10,0,10,0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<materialDesign:PackIcon Kind="{Binding Icono}" Width="16" Height="16"
																		 Foreground="#D4A574" VerticalAlignment="Center" Margin="0,0,8,0"/>
												<TextBlock Grid.Column="1" Text="{Binding Categoria}" FontSize="12"
														   FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
												<TextBlock Grid.Column="2" FontSize="11" Foreground="#AAAAAA"
														   VerticalAlignment="Center" Margin="0,0,8,0">
													<Run Text="{Binding Items.Count, Mode=OneWay}"/>
													<Run Text=" servicios"/>
												</TextBlock>
												<materialDesign:PackIcon Grid.Column="3" Width="16" Height="16"
																		 Foreground="#AAAAAA" VerticalAlignment="Center">
													<materialDesign:PackIcon.Style>
														<Style TargetType="materialDesign:PackIcon">
															<Setter Property="Kind" Value="ChevronDown"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Expandido}" Value="False">
																	<Setter Property="Kind" Value="ChevronRight"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</materialDesign:PackIcon.Style>
												</materialDesign:PackIcon>
											</Grid>
										</Border>
										<!-- Items del grupo (colapsable) -->
										<ItemsControl ItemsSource="{Binding Items}"
													  Visibility="{Binding Expandido, Converter={StaticResource BooleanToVisibilityConverter}}"
													  Padding="4,0,0,0">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border CornerRadius="7" Background="White" Margin="0,0,0,4"
															BorderThickness="1" BorderBrush="#E0E0E0" Cursor="Hand"
															MinHeight="50">
														<Border.InputBindings>
															<MouseBinding MouseAction="LeftClick"
																Command="{Binding DataContext.AgregarServicioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
																CommandParameter="{Binding}"/>
														</Border.InputBindings>
														<Grid Margin="10,8">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="Auto"/>
															</Grid.ColumnDefinitions>
															<StackPanel Grid.Column="0" VerticalAlignment="Center">
																<TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold"
																		   Foreground="#2D3436" TextTrimming="CharacterEllipsis"/>
																<TextBlock FontSize="11" Foreground="#888888" Margin="0,1,0,0">
																	<Run Text="{Binding Duracion, Mode=OneWay}"/>
																	<Run Text=" min"/>
																</TextBlock>
															</StackPanel>
															<Border Grid.Column="1" Background="#FFF4EC" CornerRadius="6"
																	Padding="8,3" VerticalAlignment="Center">
																<TextBlock FontSize="12" FontWeight="Bold" Foreground="#D4A574">
																	<Run Text="{Binding Costo, StringFormat='{}{0:F0}', Mode=OneWay}"/>
																	<Run Text="€"/>
																</TextBlock>
															</Border>
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<!-- Productos agrupados por categoría -->
				<ScrollViewer Visibility="{Binding PanelProductos, Converter={StaticResource BooleanToVisibilityConverter}}"
                              VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding GruposProductos}" Padding="8,6">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Margin="0,0,0,6">
									<StackPanel>
										<!-- Cabecera grupo -->
										<Border Background="#2D3436" CornerRadius="8" Margin="0,0,0,2"
												Cursor="Hand" MinHeight="38">
											<Border.InputBindings>
												<MouseBinding MouseAction="LeftClick" Command="{Binding ToggleCommand}"/>
											</Border.InputBindings>
											<Grid Margin="10,0,10,0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<materialDesign:PackIcon Kind="{Binding Icono}" Width="16" Height="16"
																		 Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,8,0"/>
												<TextBlock Grid.Column="1" Text="{Binding Categoria}" FontSize="12"
														   FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
												<TextBlock Grid.Column="2" FontSize="11" Foreground="#AAAAAA"
														   VerticalAlignment="Center" Margin="0,0,8,0">
													<Run Text="{Binding Items.Count, Mode=OneWay}"/>
													<Run Text=" productos"/>
												</TextBlock>
												<materialDesign:PackIcon Grid.Column="3" Width="16" Height="16"
																		 Foreground="#AAAAAA" VerticalAlignment="Center">
													<materialDesign:PackIcon.Style>
														<Style TargetType="materialDesign:PackIcon">
															<Setter Property="Kind" Value="ChevronDown"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Expandido}" Value="False">
																	<Setter Property="Kind" Value="ChevronRight"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</materialDesign:PackIcon.Style>
												</materialDesign:PackIcon>
											</Grid>
										</Border>
										<!-- Items -->
										<ItemsControl ItemsSource="{Binding Items}"
													  Visibility="{Binding Expandido, Converter={StaticResource BooleanToVisibilityConverter}}"
													  Padding="4,0,0,0">
											<ItemsControl.ItemTemplate>
												<DataTemplate>
													<Border CornerRadius="7" Background="White" Margin="0,0,0,4"
															BorderThickness="1" BorderBrush="#E0E0E0" Cursor="Hand"
															MinHeight="50">
														<Border.InputBindings>
															<MouseBinding MouseAction="LeftClick"
																Command="{Binding DataContext.AgregarProductoCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}"
																CommandParameter="{Binding}"/>
														</Border.InputBindings>
														<Grid Margin="10,8">
															<Grid.ColumnDefinitions>
																<ColumnDefinition Width="*"/>
																<ColumnDefinition Width="Auto"/>
															</Grid.ColumnDefinitions>
															<StackPanel Grid.Column="0" VerticalAlignment="Center">
																<TextBlock Text="{Binding Nombre}" FontSize="13" FontWeight="SemiBold"
																		   Foreground="#2D3436" TextTrimming="CharacterEllipsis"/>
																<TextBlock FontSize="11" Foreground="#888888" Margin="0,1,0,0">
																	<Run Text="Stock: "/>
																	<Run Text="{Binding Cantidad, Mode=OneWay}"/>
																</TextBlock>
															</StackPanel>
															<Border Grid.Column="1" Background="#E8F5E9" CornerRadius="6"
																	Padding="8,3" VerticalAlignment="Center">
																<TextBlock FontSize="12" FontWeight="Bold" Foreground="#2E7D32">
																	<Run Text="{Binding Precio, StringFormat='{}{0:F0}', Mode=OneWay}"/>
																	<Run Text="€"/>
																</TextBlock>
															</Border>
														</Grid>
													</Border>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Grid>

		<!-- ══════════════════════════════════════════════════════════════════
             COLUMNA 2 — TICKET CENTRAL
        ══════════════════════════════════════════════════════════════════ -->
		<Grid Grid.Column="1" Margin="1,0">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Cabecera ticket -->
			<Border Grid.Row="0" Background="White" Padding="24,16"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<StackPanel Grid.Column="0" VerticalAlignment="Center">
						<TextBlock Text="Ticket de Venta" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
						<TextBlock FontSize="12" Foreground="{StaticResource TextLightBrush}" Margin="0,2,0,0">
							<Run Text="{Binding LineasTicket.Count, Mode=OneWay}"/>
							<Run Text=" artículos"/>
						</TextBlock>
					</StackPanel>
					<Button Grid.Column="1" Command="{Binding LimpiarTicketCommand}"
                            Height="34" Padding="14,0" BorderThickness="0" Cursor="Hand"
                            Visibility="{Binding TieneCliente, Converter={StaticResource BooleanToVisibilityConverter}}">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8" Background="#FFEBEE" Padding="{TemplateBinding Padding}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Kind="TrashCanOutline" Width="14" Height="14"
                                                     Foreground="#D63031" VerticalAlignment="Center" Margin="0,0,6,0"/>
							<TextBlock Text="Limpiar" FontSize="12" FontWeight="SemiBold" Foreground="#D63031"/>
						</StackPanel>
					</Button>
				</Grid>
			</Border>

			<!-- Selector de cliente -->
			<Border Grid.Row="1" Background="#F8F9FA" Padding="20,12"
                    BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
				<Grid>
					<!-- Cliente seleccionado -->
					<Border Visibility="{Binding TieneCliente, Converter={StaticResource BooleanToVisibilityConverter}}">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto"/>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<Ellipse Grid.Column="0" Width="40" Height="40" Fill="{StaticResource AccentBrush}" Margin="0,0,12,0"/>
							<TextBlock Grid.Column="0" Text="{Binding NombreCliente, Converter={StaticResource StringToFirstCharConverter}}"
									   FontSize="16" FontWeight="Bold" Foreground="White"
									   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,12,0"/>
							<StackPanel Grid.Column="1" VerticalAlignment="Center">
								<TextBlock Text="{Binding NombreCliente}" FontSize="14" FontWeight="SemiBold"
										   Foreground="{StaticResource TextBrush}"/>
								<TextBlock Text="{Binding TelefonoCliente}" FontSize="12"
										   Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
							<Button Grid.Column="2" Command="{Binding LimpiarClienteCommand}"
									Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
								<materialDesign:PackIcon Kind="Close" Width="14" Height="14" Foreground="{StaticResource TextLightBrush}"/>
							</Button>
						</Grid>
					</Border>

					<!-- Sin cliente: buscador inline -->
					<Grid Visibility="{Binding TieneCliente, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Border Grid.Row="0" Background="White" CornerRadius="8"
								BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1">
							<Grid>
								<materialDesign:PackIcon Kind="AccountSearch" Width="16" Height="16"
														 Foreground="{StaticResource TextLightBrush}"
														 Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
								<TextBox Text="{Binding BusquedaCliente, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										 Margin="30,0,8,0" Height="36" BorderThickness="0"
										 Background="Transparent" FontSize="13" VerticalContentAlignment="Center">
									<TextBox.Template>
										<ControlTemplate TargetType="TextBox">
											<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
										</ControlTemplate>
									</TextBox.Template>
								</TextBox>
								<TextBlock Text="Buscar cliente por nombre o teléfono..."
										   FontSize="12" Foreground="{StaticResource TextLightBrush}"
										   Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Visibility" Value="Collapsed"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding BusquedaCliente}" Value="">
													<Setter Property="Visibility" Value="Visible"/>
												</DataTrigger>
												<DataTrigger Binding="{Binding BusquedaCliente}" Value="{x:Null}">
													<Setter Property="Visibility" Value="Visible"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</Grid>
						</Border>
						<!-- Sugerencias clientes -->
						<Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,4,0,0"
								BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1"
								MaxHeight="140"
								Visibility="{Binding HaySugerenciasClientes, Converter={StaticResource BooleanToVisibilityConverter}}">
							<ListBox ItemsSource="{Binding ClientesFiltrados}"
									 BorderThickness="0" Background="Transparent">
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Button Command="{Binding DataContext.SeleccionarClienteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
												CommandParameter="{Binding}"
												Background="Transparent" BorderThickness="0" Cursor="Hand"
												HorizontalContentAlignment="Stretch">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border Padding="12,8" Background="{TemplateBinding Background}">
														<ContentPresenter/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												<TextBlock Text="{Binding Nombre}" FontSize="13"
														   Foreground="{StaticResource TextBrush}"/>
												<TextBlock Grid.Column="1" Text="{Binding Telefono}" FontSize="12"
														   Foreground="{StaticResource TextLightBrush}"/>
											</Grid>
										</Button>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</Border>
					</Grid>
				</Grid>
			</Border>

			<!-- Líneas del ticket -->
			<Grid Grid.Row="2">
				<!-- Estado vacío -->
				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding TicketVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
					<materialDesign:PackIcon Kind="ReceiptText" Width="52" Height="52"
                                             Foreground="{StaticResource MediumGrayBrush}"
                                             HorizontalAlignment="Center" Margin="0,0,0,16"/>
					<TextBlock Text="Ticket vacío" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextLightBrush}" HorizontalAlignment="Center"/>
					<TextBlock Text="Pulsa un servicio o producto del catálogo"
                               FontSize="12" Foreground="{StaticResource MediumGrayBrush}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
				</StackPanel>

				<ScrollViewer Visibility="{Binding TicketVacio, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                              VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding LineasTicket}" Padding="16,12">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,8">
									<Border.Effect>
										<DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.04"/>
									</Border.Effect>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Badge tipo -->
										<Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Margin="0,0,12,0">
											<Border.Style>
												<Style TargetType="Border">
													<Setter Property="Background" Value="#E8F5E9"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding Tipo}" Value="Servicio">
															<Setter Property="Background" Value="#FFF4EC"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</Border.Style>
											<materialDesign:PackIcon Width="16" Height="16"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center">
												<materialDesign:PackIcon.Style>
													<Style TargetType="materialDesign:PackIcon">
														<Setter Property="Kind" Value="Package"/>
														<Setter Property="Foreground" Value="#2E7D32"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding Tipo}" Value="Servicio">
																<Setter Property="Kind" Value="Scissors"/>
																<Setter Property="Foreground" Value="#D4A574"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</materialDesign:PackIcon.Style>
											</materialDesign:PackIcon>
										</Border>

										<!-- Nombre + precio unit -->
										<StackPanel Grid.Column="1" VerticalAlignment="Center">
											<TextBlock Text="{Binding Descripcion}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
											<TextBlock FontSize="11" Foreground="{StaticResource TextLightBrush}">
												<Run Text="{Binding PrecioUnitario, StringFormat='{}{0:F2}', Mode=OneWay}"/>
												<Run Text=" € / ud."/>
											</TextBlock>
										</StackPanel>

										<!-- Controles cantidad -->
										<Border Grid.Column="2" Background="{StaticResource LightGrayBrush}"
                                                CornerRadius="8" Margin="12,0">
											<StackPanel Orientation="Horizontal">
												<Button Command="{Binding DataContext.DecrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
													<TextBlock Text="−" FontSize="16" FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
												</Button>
												<TextBlock Text="{Binding Cantidad}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
												<Button Command="{Binding DataContext.IncrementarCantidadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand">
													<TextBlock Text="+" FontSize="16" FontWeight="Bold"
                                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
												</Button>
											</StackPanel>
										</Border>

										<!-- Importe + eliminar -->
										<StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
											<TextBlock FontSize="15" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" TextAlignment="Right">
												<Run Text="{Binding Importe, StringFormat='{}{0:F2}', Mode=OneWay}"/>
												<Run Text=" €"/>
											</TextBlock>
											<Button Command="{Binding DataContext.EliminarLineaCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                    HorizontalAlignment="Right" Margin="0,4,0,0">
												<TextBlock Text="Eliminar" FontSize="10"
                                                           Foreground="#D63031" TextDecorations="Underline"/>
											</Button>
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>

			<!-- Subtotal rápido en el ticket -->
			<Border Grid.Row="3" Background="White" Padding="20,14"
                    BorderThickness="0,1,0,0" BorderBrush="{StaticResource MediumGrayBrush}"
                    Visibility="{Binding TicketVacio, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock Text="SUBTOTAL" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
					<TextBlock Grid.Column="1" Text="{Binding SubtotalTexto}" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>
				</Grid>
			</Border>
		</Grid>

		<!-- ══════════════════════════════════════════════════════════════════
             COLUMNA 3 — PAGO
        ══════════════════════════════════════════════════════════════════ -->
		<Grid Grid.Column="2" Background="White">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<!-- Cabecera pago -->
			<Border Grid.Row="0" Background="#2D3436" Padding="20,16">
				<StackPanel>
					<TextBlock Text="RESUMEN DEL PAGO" FontSize="11" FontWeight="Bold"
                               Foreground="#AAAAAA" Margin="0,0,0,4"/>
					<TextBlock Text="Peluquería Charo" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
				</StackPanel>
			</Border>

			<!-- Totales y método -->
			<StackPanel Grid.Row="1" Margin="20,20,20,0">
				<!-- Desglose -->
				<Border Background="{StaticResource LightGrayBrush}" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
					<StackPanel>
						<Grid Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="Subtotal" FontSize="13" Foreground="{StaticResource TextLightBrush}"/>
							<TextBlock Grid.Column="1" Text="{Binding SubtotalTexto}" FontSize="13" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
						</Grid>
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="Descuento" FontSize="13" Foreground="{StaticResource TextLightBrush}"/>
							<TextBlock Grid.Column="1" Text="{Binding DescuentoTexto}" FontSize="13" Foreground="#D63031" FontWeight="SemiBold"/>
						</Grid>
					</StackPanel>
				</Border>

				<!-- TOTAL grande -->
				<Border Background="#2D3436" CornerRadius="12" Padding="20,18" Margin="0,0,0,20">
					<StackPanel HorizontalAlignment="Center">
						<TextBlock Text="TOTAL A COBRAR" FontSize="10" FontWeight="Bold"
                                   Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
						<TextBlock Text="{Binding TotalTexto}" FontSize="34" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"/>
					</StackPanel>
				</Border>

				<!-- Descuento manual -->
				<TextBlock Text="DESCUENTO (€)" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,6"/>
				<Border Background="{StaticResource LightGrayBrush}" CornerRadius="8" Margin="0,0,0,20"
                        BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1">
					<TextBox Text="{Binding Descuento, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                             Height="38" BorderThickness="0" Background="Transparent"
                             FontSize="15" FontWeight="SemiBold" TextAlignment="Center"
                             VerticalContentAlignment="Center">
						<TextBox.Template>
							<ControlTemplate TargetType="TextBox">
								<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
							</ControlTemplate>
						</TextBox.Template>
					</TextBox>
				</Border>

				<!-- Método de pago -->
				<TextBlock Text="MÉTODO DE PAGO" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextLightBrush}" Margin="0,0,0,10"/>
				<UniformGrid Columns="2" Margin="0,0,0,0">
					<Button Command="{Binding SeleccionarMetodoPagoCommand}" CommandParameter="Efectivo"
                            Margin="0,0,4,4" Height="44" BorderThickness="0" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8" BorderThickness="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
											<Setter Property="BorderBrush" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding MetodoPago}" Value="Efectivo">
													<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
													<Setter Property="Background" Value="#FFF4EC"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Kind="Cash" Width="16" Height="16" VerticalAlignment="Center"
                                                     Margin="0,0,6,0" Foreground="{StaticResource TextBrush}"/>
							<TextBlock Text="Efectivo" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
					<Button Command="{Binding SeleccionarMetodoPagoCommand}" CommandParameter="Tarjeta"
                            Height="44" Margin="4,0,0,4" BorderThickness="0" Cursor="Hand">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8" BorderThickness="2">
									<Border.Style>
										<Style TargetType="Border">
											<Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
											<Setter Property="BorderBrush" Value="Transparent"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding MetodoPago}" Value="Tarjeta">
													<Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
													<Setter Property="Background" Value="#FFF4EC"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</Border.Style>
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
						<StackPanel Orientation="Horizontal">
							<materialDesign:PackIcon Kind="CreditCard" Width="16" Height="16" VerticalAlignment="Center"
                                                     Margin="0,0,6,0" Foreground="{StaticResource TextBrush}"/>
							<TextBlock Text="Tarjeta" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</UniformGrid>

				<!-- ComboBox método de pago -->
				<Border Background="{StaticResource LightGrayBrush}" CornerRadius="8" Margin="0,8,0,0"
                        BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1">
					<ComboBox ItemsSource="{Binding MetodosPago}"
                              SelectedItem="{Binding MetodoPago}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextBrush}" FontSize="14"
                              FontWeight="SemiBold" Padding="12,0" Height="42"
                              VerticalContentAlignment="Center"/>
				</Border>
			</StackPanel>

			<!-- Botón cobrar -->
			<Border Grid.Row="2" Padding="16,16">
				<Button Command="{Binding CobrarCommand}"
                        Height="56" BorderThickness="0" Cursor="Hand">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border CornerRadius="12" Padding="16"
                                    Background="{StaticResource AccentBrush}">
								<Border.Style>
									<Style TargetType="Border">
										<Style.Triggers>
											<DataTrigger Binding="{Binding TicketVacio}" Value="True">
												<Setter Property="Background" Value="{StaticResource MediumGrayBrush}"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</ControlTemplate>
					</Button.Template>
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="CreditCardCheck" Width="24" Height="24"
                                                 Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="COBRAR" FontSize="16" FontWeight="Bold" Foreground="White"/>
							<TextBlock Text="{Binding TotalTexto}" FontSize="13" Foreground="White" Opacity="0.85"/>
						</StackPanel>
					</StackPanel>
				</Button>
			</Border>
		</Grid>
	</Grid>
</UserControl>
