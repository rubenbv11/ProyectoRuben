<UserControl x:Class="ProyectoRuben.Frontend.UCServicios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ ENCABEZADO ══ -->
		<Border Grid.Row="0" Background="White" Padding="32,24"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Catálogo de Servicios"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Visualiza y administra todos los servicios ofrecidos"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}"
                               Margin="0,4,0,0"/>
				</StackPanel>

				<Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Foreground="White" Height="40"
                        Padding="16,0" Cursor="Hand"
                        Command="{Binding AgregarServicioCommand}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
						<TextBlock Text="Nuevo Servicio" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!-- ══ BARRA BÚSQUEDA + CONTADOR ══ -->
		<Border Grid.Row="1" Background="White" Padding="32,14"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="360"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<Border Grid.Column="0" Background="{StaticResource LightGrayBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource MediumGrayBrush}"
                        BorderThickness="1">
					<Grid>
						<materialDesign:PackIcon Kind="Magnify"
                                                 Foreground="{StaticResource TextLightBrush}"
                                                 Width="18" Height="18"
                                                 Margin="12,0,0,0"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"/>
						<TextBox Text="{Binding FiltroNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="36,0,10,0" Height="36"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="13" VerticalContentAlignment="Center">
							<TextBox.Template>
								<ControlTemplate TargetType="TextBox">
									<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
								</ControlTemplate>
							</TextBox.Template>
						</TextBox>
						<TextBlock Text="Buscar por nombre..."
                                   Foreground="{StaticResource TextLightBrush}"
                                   FontSize="13" Margin="38,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
				</Border>

				<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock FontSize="13" Foreground="{StaticResource TextLightBrush}">
						<Run Text="{Binding TotalServicios}"/>
						<Run Text="servicios activos"/>
					</TextBlock>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENIDO ══ -->
		<Grid Grid.Row="2">

			<!-- Estado vacío -->
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource MediumGrayBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
					<materialDesign:PackIcon Kind="Scissors" Foreground="White"
                                             Width="36" Height="36"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
				</Border>
				<TextBlock Text="Sin servicios registrados"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
				<TextBlock Text="Comienza agregando tu primer servicio"
                           FontSize="13" Foreground="{StaticResource TextLightBrush}"
                           HorizontalAlignment="Center"/>
			</StackPanel>

			<!-- Grid de cards 2 columnas -->
			<ScrollViewer Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding ListaServiciosView}"
                              Padding="28,20,28,28">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<!-- 2 columnas uniformes -->
							<UniformGrid Columns="2"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<!-- ── CARD ── -->
							<Border Margin="0,0,10,10"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="18,16">
								<Border.Effect>
									<DropShadowEffect BlurRadius="10" ShadowDepth="1"
                                                      Direction="270" Color="#000000" Opacity="0.05"/>
								</Border.Effect>

								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>

									<!-- Icono + nombre + descripción -->
									<StackPanel Grid.Row="0" Orientation="Horizontal"
                                                Margin="0,0,0,10">
										<Border Width="42" Height="42" CornerRadius="10"
                                                Background="{StaticResource AccentBrush}"
                                                Margin="0,0,12,0">
											<materialDesign:PackIcon Kind="Scissors"
                                                                     Width="20" Height="20"
                                                                     Foreground="White"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
										</Border>
										<StackPanel VerticalAlignment="Center" MaxWidth="260">
											<TextBlock Text="{Binding Nombre}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding Descripcion}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextLightBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
										</StackPanel>
									</StackPanel>

									<!-- Separador -->
									<Rectangle Grid.Row="1" Height="1"
                                               Fill="{StaticResource MediumGrayBrush}"
                                               VerticalAlignment="Top"
                                               Margin="0,0,0,10"/>

									<!-- Pills precio + duración + botones -->
									<Grid Grid.Row="2">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*"/>
											<ColumnDefinition Width="Auto"/>
										</Grid.ColumnDefinitions>

										<!-- Pills -->
										<StackPanel Grid.Column="0" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
											<!-- Precio -->
											<Border Background="#FFF4EC" CornerRadius="99"
                                                    Padding="10,4" Margin="0,0,8,0">
												<TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#A0622A">
													<Run Text="{Binding Costo, StringFormat='{}{0:F2}'}"/>
													<Run Text=" €"/>
												</TextBlock>
											</Border>

											<!-- Duración -->
											<Border Background="{StaticResource LightGrayBrush}"
                                                    CornerRadius="99" Padding="10,4">
												<StackPanel Orientation="Horizontal">
													<materialDesign:PackIcon Kind="ClockOutline"
                                                                             Width="13" Height="13"
                                                                             Foreground="{StaticResource TextLightBrush}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,4,0"/>
													<TextBlock FontSize="12"
                                                               Foreground="{StaticResource TextLightBrush}">
														<Run Text="{Binding Duracion}"/>
														<Run Text=" min"/>
													</TextBlock>
												</StackPanel>
											</Border>
										</StackPanel>

										<!-- Botones -->
										<StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
											<!-- Editar -->
											<Button Width="32" Height="32"
                                                    Background="Transparent"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource MediumGrayBrush}"
                                                    Cursor="Hand" Margin="0,0,6,0"
                                                    ToolTip="Editar servicio"
                                                    Command="{Binding DataContext.EditarServicioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="Pencil" Width="15" Height="15"
                                                                         Foreground="{StaticResource TextLightBrush}"/>
											</Button>

											<!-- Desactivar -->
											<Button Width="32" Height="32"
                                                    Background="#FFF0F0"
                                                    BorderThickness="1"
                                                    BorderBrush="#FFCDD2"
                                                    Cursor="Hand"
                                                    ToolTip="Desactivar servicio"
                                                    Command="{Binding DataContext.DesactivarServicioCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}">
												<Button.Template>
													<ControlTemplate TargetType="Button">
														<Border CornerRadius="8"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
															<ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
														</Border>
													</ControlTemplate>
												</Button.Template>
												<materialDesign:PackIcon Kind="TrashCanOutline" Width="15" Height="15"
                                                                         Foreground="#D63031"/>
											</Button>
										</StackPanel>
									</Grid>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
