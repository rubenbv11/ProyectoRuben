<Window x:Class="ProyectoRuben.Frontend.DialogoEliminar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Advertencia" Height="220" Width="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">

	<Border Background="White" CornerRadius="12" Margin="10">
		<Border.Effect>
			<DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2"/>
		</Border.Effect>

		<Grid Margin="20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
				<materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#E53935" Width="28" Height="28"/>
				<TextBlock Text="Advertencia" FontSize="18" FontWeight="SemiBold"
                           Foreground="#333333" Margin="10,0,0,0" VerticalAlignment="Center"/>
			</StackPanel>

			<TextBlock Grid.Row="1" x:Name="txtMensaje" Text="¿Estás seguro que deseas eliminar la reserva?"
                       FontSize="15" Foreground="#666666" TextWrapping="Wrap" VerticalAlignment="Center"/>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
				<Button Content="Cancelar" Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="#666666" BorderBrush="#CCCCCC" Margin="0,0,10,0" Width="100"
                        Click="BtnCancelar_Click"/>

				<Button Content="Eliminar" Style="{StaticResource MaterialDesignFlatMidBgButton}"
                        Background="#E53935" BorderBrush="#E53935" Foreground="White" Width="100"
                        Click="BtnEliminar_Click"/>
			</StackPanel>
		</Grid>
	</Border>
</Window>