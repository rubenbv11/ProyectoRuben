<UserControl x:Class="ProyectoRuben.Frontend.UCDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ ENCABEZADO ══ -->
		<Border Grid.Row="0" Background="White" Padding="32,24"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Resumen del negocio en tiempo real"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0"/>
				</StackPanel>
				<Button Grid.Column="1" Width="40" Height="40" Background="Transparent"
                        BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                        Cursor="Hand" ToolTip="Actualizar datos"
                        Command="{Binding RefrescarCommand}">
					<Button.Template>
						<ControlTemplate TargetType="Button">
							<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
								<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
						</ControlTemplate>
					</Button.Template>
					<materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                             Foreground="{StaticResource TextLightBrush}"/>
				</Button>
			</Grid>
		</Border>

		<!-- ══ CONTENIDO ══ -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="28,20,28,28">

				<!-- ══ FILA 1: KPIs ══ -->
				<Grid Margin="0,0,0,16">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="12"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>

					<!-- Reservas hoy -->
					<Border Grid.Column="0" Background="#2D3436" CornerRadius="14" Padding="20,18">
						<StackPanel>
							<Border Width="36" Height="36" CornerRadius="10"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left" Margin="0,0,0,14">
								<materialDesign:PackIcon Kind="CalendarToday" Width="18" Height="18"
                                                         Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<TextBlock Text="{Binding ReservasHoy}" FontSize="32" FontWeight="Bold"
                                       Foreground="White" Margin="0,0,0,4"/>
							<TextBlock Text="Reservas hoy" FontSize="12" Foreground="#AAAAAA"/>
						</StackPanel>
					</Border>

					<!-- Clientes este mes -->
					<Border Grid.Column="2" Background="White" CornerRadius="14" Padding="20,18">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
						</Border.Effect>
						<StackPanel>
							<Border Width="36" Height="36" CornerRadius="10"
                                    Background="#F3E5F5" HorizontalAlignment="Left" Margin="0,0,0,14">
								<materialDesign:PackIcon Kind="AccountGroup" Width="18" Height="18"
                                                         Foreground="#6A1B9A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<TextBlock Text="{Binding ClientesAtendidosMes}" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
							<TextBlock Text="Clientes este mes" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
						</StackPanel>
					</Border>

					<!-- Ingresos hoy -->
					<Border Grid.Column="4" Background="White" CornerRadius="14" Padding="20,18">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
						</Border.Effect>
						<StackPanel>
							<Border Width="36" Height="36" CornerRadius="10"
                                    Background="#E8F5E9" HorizontalAlignment="Left" Margin="0,0,0,14">
								<materialDesign:PackIcon Kind="CurrencyEur" Width="18" Height="18"
                                                         Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Border>
							<TextBlock Text="{Binding IngresosHoy}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
							<TextBlock Text="Ingresos hoy" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
						</StackPanel>
					</Border>

					<!-- Stock bajo -->
					<Border Grid.Column="6" CornerRadius="14" Padding="20,18">
						<Border.Style>
							<Style TargetType="Border">
								<Setter Property="Background" Value="White"/>
								<Setter Property="Effect">
									<Setter.Value>
										<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
									</Setter.Value>
								</Setter>
								<Style.Triggers>
									<DataTrigger Binding="{Binding HayStockBajo}" Value="True">
										<Setter Property="Background" Value="#FFF8E1"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Border.Style>
						<StackPanel>
							<Border Width="36" Height="36" CornerRadius="10"
                                    HorizontalAlignment="Left" Margin="0,0,0,14">
								<Border.Style>
									<Style TargetType="Border">
										<Setter Property="Background" Value="#E3F2FD"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding HayStockBajo}" Value="True">
												<Setter Property="Background" Value="#FFE0B2"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Border.Style>
								<materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
									<materialDesign:PackIcon.Style>
										<Style TargetType="materialDesign:PackIcon">
											<Setter Property="Foreground" Value="#1565C0"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding HayStockBajo}" Value="True">
													<Setter Property="Foreground" Value="#E65100"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</materialDesign:PackIcon.Style>
								</materialDesign:PackIcon>
							</Border>
							<TextBlock Text="{Binding ProductosBajoStock}" FontSize="32" FontWeight="Bold"
                                       Margin="0,0,0,4">
								<TextBlock.Style>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
										<Style.Triggers>
											<DataTrigger Binding="{Binding HayStockBajo}" Value="True">
												<Setter Property="Foreground" Value="#E65100"/>
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</TextBlock.Style>
							</TextBlock>
							<TextBlock Text="Productos stock bajo" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
						</StackPanel>
					</Border>
				</Grid>

				<!-- ══ FILA 2: Citas del día ══ -->
				<Border Background="White" CornerRadius="14" Padding="24">
					<Border.Effect>
						<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
					</Border.Effect>
					<StackPanel>

						<!-- Cabecera -->
						<StackPanel Orientation="Horizontal" Margin="0,0,0,20">
							<materialDesign:PackIcon Kind="CalendarClock" Width="20" Height="20"
                                                     Foreground="{StaticResource AccentBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
							<TextBlock Text="Citas de hoy" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
							<Border CornerRadius="99" Background="#FFF3E0" Padding="8,3" Margin="10,0,0,0"
                                    VerticalAlignment="Center">
								<TextBlock FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="{Binding ReservasHoy}"/>
							</Border>
						</StackPanel>

						<!-- Estado vacío -->
						<StackPanel HorizontalAlignment="Center" Margin="0,20"
                                    Visibility="{Binding SinCitasHoy, Converter={StaticResource BooleanToVisibilityConverter}}">
							<materialDesign:PackIcon Kind="CalendarBlankOutline" Width="48" Height="48"
                                                     Foreground="{StaticResource MediumGrayBrush}"
                                                     HorizontalAlignment="Center" Margin="0,0,0,12"/>
							<TextBlock Text="No hay citas programadas para hoy"
                                       FontSize="14" Foreground="{StaticResource TextLightBrush}"
                                       HorizontalAlignment="Center"/>
						</StackPanel>

						<!-- Lista de citas -->
						<ItemsControl ItemsSource="{Binding ProximasCitas}"
                                      Visibility="{Binding SinCitasHoy, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<!-- Una fila por cita, sin bordes ni rayas -->
									<Border Padding="0,10" Margin="0,0,0,2">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="Transparent"/>
												<Style.Triggers>
													<Trigger Property="IsMouseOver" Value="True">
														<Setter Property="Background" Value="#FFF8F2"/>
													</Trigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="80"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="140"/>
												<ColumnDefinition Width="110"/>
												<ColumnDefinition Width="Auto"/>
											</Grid.ColumnDefinitions>

											<!-- Hora -->
											<TextBlock Grid.Column="0" Text="{Binding Hora}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       VerticalAlignment="Center"/>

											<!-- Cliente -->
											<TextBlock Grid.Column="1" Text="{Binding Cliente}"
                                                       FontSize="13" Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

											<!-- Servicio -->
											<TextBlock Grid.Column="2" Text="{Binding Servicio}"
                                                       FontSize="13" Foreground="{StaticResource TextLightBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

											<!-- Empleado -->
											<TextBlock Grid.Column="3" Text="{Binding Empleado}"
                                                       FontSize="12" Foreground="{StaticResource TextLightBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>

											<!-- Badge estado -->
											<Border Grid.Column="4" CornerRadius="99" Padding="10,4"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
												<Border.Style>
													<Style TargetType="Border">
														<Setter Property="Background" Value="#F5F5F5"/>
														<Style.Triggers>
															<DataTrigger Binding="{Binding Estado}" Value="Pendiente">
																<Setter Property="Background" Value="#FFF3E0"/>
															</DataTrigger>
															<DataTrigger Binding="{Binding Estado}" Value="Confirmada">
																<Setter Property="Background" Value="#E3F2FD"/>
															</DataTrigger>
															<DataTrigger Binding="{Binding Estado}" Value="Completada">
																<Setter Property="Background" Value="#E8F5E9"/>
															</DataTrigger>
															<DataTrigger Binding="{Binding Estado}" Value="Cancelada">
																<Setter Property="Background" Value="#FFEBEE"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Border.Style>
												<TextBlock Text="{Binding Estado}" FontSize="11" FontWeight="SemiBold">
													<TextBlock.Style>
														<Style TargetType="TextBlock">
															<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Estado}" Value="Pendiente">
																	<Setter Property="Foreground" Value="#EF6C00"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Estado}" Value="Confirmada">
																	<Setter Property="Foreground" Value="#1565C0"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Estado}" Value="Completada">
																	<Setter Property="Foreground" Value="#2E7D32"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Estado}" Value="Cancelada">
																	<Setter Property="Foreground" Value="#C62828"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</TextBlock.Style>
												</TextBlock>
											</Border>

											<!-- Botón Cobrar (solo si no está Completada ni Cancelada) -->
											<Button Grid.Column="5" Height="32" Padding="12,0"
                                                    Cursor="Hand" Margin="8,0,0,0"
                                                    Tag="{Binding ReservaId}"
                                                    Click="BtnCobrarCita_Click"
                                                    ToolTip="Cobrar esta reserva en Caja">
												<Button.Style>
													<Style TargetType="Button">
														<Setter Property="Background" Value="#E8F5E9"/>
														<Setter Property="BorderThickness" Value="1"/>
														<Setter Property="BorderBrush" Value="#C8E6C9"/>
														<Setter Property="Visibility" Value="Visible"/>
														<Setter Property="Template">
															<Setter.Value>
																<ControlTemplate TargetType="Button">
																	<Border CornerRadius="8"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                                            BorderThickness="{TemplateBinding BorderThickness}">
																		<ContentPresenter HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="{TemplateBinding Padding}"/>
																	</Border>
																</ControlTemplate>
															</Setter.Value>
														</Setter>
														<Style.Triggers>
															<DataTrigger Binding="{Binding Estado}" Value="Completada">
																<Setter Property="Visibility" Value="Collapsed"/>
															</DataTrigger>
															<DataTrigger Binding="{Binding Estado}" Value="Cancelada">
																<Setter Property="Visibility" Value="Collapsed"/>
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Button.Style>
												<StackPanel Orientation="Horizontal">
													<materialDesign:PackIcon Kind="CashRegister"
                                                                             Width="14" Height="14"
                                                                             Foreground="#2E7D32"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0,0,5,0"/>
													<TextBlock Text="Cobrar" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#2E7D32" VerticalAlignment="Center"/>
												</StackPanel>
											</Button>

										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

					</StackPanel>
				</Border>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
