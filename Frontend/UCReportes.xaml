<UserControl x:Class="ProyectoRuben.Frontend.UCReportes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ ENCABEZADO ══ -->
		<Border Grid.Row="0" Background="White" Padding="32,20"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Reportes de Facturación" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Consulta el historial de cobros por período"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0"/>
				</StackPanel>

				<!-- Filtros -->
				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<!-- Mes -->
					<Border Background="{StaticResource LightGrayBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1"
                            Margin="0,0,10,0" Height="40">
						<ComboBox ItemsSource="{Binding Meses}"
                                  SelectedItem="{Binding MesSeleccionado}"
                                  Background="Transparent" BorderThickness="0"
                                  FontSize="13" FontWeight="SemiBold" Padding="12,0" MinWidth="130"
                                  VerticalContentAlignment="Center"/>
					</Border>
					<!-- Año -->
					<Border Background="{StaticResource LightGrayBrush}" CornerRadius="8"
                            BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1"
                            Margin="0,0,10,0" Height="40">
						<ComboBox ItemsSource="{Binding Anios}"
                                  SelectedItem="{Binding AnioSeleccionado}"
                                  Background="Transparent" BorderThickness="0"
                                  FontSize="13" FontWeight="SemiBold" Padding="12,0" MinWidth="80"
                                  VerticalContentAlignment="Center"/>
					</Border>
					<!-- Refrescar -->
					<Button Width="40" Height="40" Background="Transparent"
                            BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                            Cursor="Hand" Command="{Binding RefrescarCommand}" ToolTip="Refrescar">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
									<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
							</ControlTemplate>
						</Button.Template>
						<materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"
                                                 Foreground="{StaticResource TextLightBrush}"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENIDO ══ -->
		<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
			<StackPanel Margin="28,20,28,28">

				<!-- Sin datos -->
				<Border Background="White" CornerRadius="12" Padding="48"
                        Visibility="{Binding SinDatos, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel HorizontalAlignment="Center">
						<materialDesign:PackIcon Kind="ReceiptTextOutline" Width="56" Height="56"
                                                 Foreground="{StaticResource MediumGrayBrush}"
                                                 HorizontalAlignment="Center" Margin="0,0,0,16"/>
						<TextBlock Text="Sin facturas en este período"
                                   FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
						<TextBlock Text="No se encontraron cobros registrados para el mes seleccionado"
                                   FontSize="13" Foreground="{StaticResource TextLightBrush}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
					</StackPanel>
				</Border>

				<!-- Contenido con datos -->
				<StackPanel Visibility="{Binding SinDatos, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">

					<!-- ══ KPIs ══ -->
					<Grid Margin="0,0,0,20">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="12"/>
							<ColumnDefinition Width="*"/>
						</Grid.ColumnDefinitions>

						<!-- Ingresos -->
						<Border Grid.Column="0" Background="#2D3436" CornerRadius="14" Padding="22,20">
							<StackPanel>
								<Border Width="38" Height="38" CornerRadius="10" Background="#D4A574"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
									<materialDesign:PackIcon Kind="CurrencyEur" Width="20" Height="20"
                                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding IngresosMesTexto}" FontSize="26" FontWeight="Bold"
                                           Foreground="White" Margin="0,0,0,4"/>
								<TextBlock Text="Ingresos del mes" FontSize="12" Foreground="#AAAAAA"/>
							</StackPanel>
						</Border>

						<!-- Facturas -->
						<Border Grid.Column="2" Background="White" CornerRadius="14" Padding="22,20">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<Border Width="38" Height="38" CornerRadius="10" Background="#E3F2FD"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
									<materialDesign:PackIcon Kind="Receipt" Width="20" Height="20"
                                                             Foreground="#1565C0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding TotalFacturas}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="Facturas emitidas" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
						</Border>

						<!-- Ticket medio -->
						<Border Grid.Column="4" Background="White" CornerRadius="14" Padding="22,20">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<Border Width="38" Height="38" CornerRadius="10" Background="#FFF3E0"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
									<materialDesign:PackIcon Kind="TagOutline" Width="20" Height="20"
                                                             Foreground="#EF6C00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding TicketMedioTexto}" FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="Ticket medio" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
						</Border>

						<!-- Método top -->
						<Border Grid.Column="6" Background="White" CornerRadius="14" Padding="22,20">
							<Border.Effect>
								<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
							</Border.Effect>
							<StackPanel>
								<Border Width="38" Height="38" CornerRadius="10" Background="#E8F5E9"
                                        HorizontalAlignment="Left" Margin="0,0,0,14">
									<materialDesign:PackIcon Kind="CreditCard" Width="20" Height="20"
                                                             Foreground="#2E7D32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
								</Border>
								<TextBlock Text="{Binding MetodoPagoTop}" FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
								<TextBlock Text="Pago más usado" FontSize="12" Foreground="{StaticResource TextLightBrush}"/>
							</StackPanel>
						</Border>
					</Grid>

					<!-- ══ TABLA FACTURAS ══ -->
					<Border Background="White" CornerRadius="14" Padding="0">
						<Border.Effect>
							<DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
						</Border.Effect>
						<StackPanel>
							<!-- Cabecera tabla -->
							<Border Padding="24,18" BorderThickness="0,0,0,1"
                                    BorderBrush="{StaticResource MediumGrayBrush}">
								<StackPanel Orientation="Horizontal">
									<materialDesign:PackIcon Kind="Receipt" Width="20" Height="20"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
									<TextBlock Text="Detalle de facturas" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
									<Border Background="{StaticResource LightGrayBrush}" CornerRadius="99"
                                            Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
										<TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextLightBrush}">
											<Run Text="{Binding TotalFacturas}"/>
											<Run Text=" registros"/>
										</TextBlock>
									</Border>
								</StackPanel>
							</Border>

							<!-- DataGrid -->
							<DataGrid ItemsSource="{Binding Facturas}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      Background="Transparent" BorderThickness="0"
                                      RowHeight="52" ColumnHeaderHeight="44"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource MediumGrayBrush}"
                                      Margin="16,0,16,16">

								<DataGrid.ColumnHeaderStyle>
									<Style TargetType="DataGridColumnHeader">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
										<Setter Property="FontWeight" Value="SemiBold"/>
										<Setter Property="FontSize" Value="12"/>
										<Setter Property="Padding" Value="8,0"/>
										<Setter Property="BorderThickness" Value="0,0,0,1"/>
										<Setter Property="BorderBrush" Value="{StaticResource MediumGrayBrush}"/>
									</Style>
								</DataGrid.ColumnHeaderStyle>

								<DataGrid.RowStyle>
									<Style TargetType="DataGridRow">
										<Setter Property="Background" Value="Transparent"/>
										<Setter Property="BorderThickness" Value="0"/>
										<Style.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</DataGrid.RowStyle>

								<DataGrid.CellStyle>
									<Style TargetType="DataGridCell">
										<Setter Property="BorderThickness" Value="0"/>
										<Setter Property="Padding" Value="8,0"/>
										<Setter Property="VerticalAlignment" Value="Center"/>
										<Setter Property="FontSize" Value="13"/>
										<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
										<Style.Triggers>
											<Trigger Property="IsSelected" Value="True">
												<Setter Property="Background" Value="Transparent"/>
												<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
											</Trigger>
										</Style.Triggers>
									</Style>
								</DataGrid.CellStyle>

								<DataGrid.Columns>
									<DataGridTextColumn Header="Nº" Binding="{Binding Id}" Width="60"/>
									<DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="100"/>
									<DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
									<DataGridTextColumn Header="Método" Binding="{Binding MetodoPago}" Width="110"/>
									<DataGridTextColumn Header="Subtotal" Binding="{Binding SubtotalTexto}" Width="100"/>
									<DataGridTextColumn Header="Descuento" Binding="{Binding DescuentoTexto}" Width="100"/>

									<!-- Total con badge de color -->
									<DataGridTemplateColumn Header="Total" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding TotalTexto}" FontSize="14" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>

									<!-- Estado con badge -->
									<DataGridTemplateColumn Header="Estado" Width="100">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate>
												<Border CornerRadius="99" Padding="10,4" HorizontalAlignment="Left" VerticalAlignment="Center">
													<Border.Style>
														<Style TargetType="Border">
															<Setter Property="Background" Value="{StaticResource LightGrayBrush}"/>
															<Style.Triggers>
																<DataTrigger Binding="{Binding Estado}" Value="Pagada">
																	<Setter Property="Background" Value="#E8F5E9"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Estado}" Value="Anulada">
																	<Setter Property="Background" Value="#FFEBEE"/>
																</DataTrigger>
																<DataTrigger Binding="{Binding Estado}" Value="Pendiente">
																	<Setter Property="Background" Value="#FFF3E0"/>
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</Border.Style>
													<TextBlock Text="{Binding Estado}" FontSize="11" FontWeight="SemiBold">
														<TextBlock.Style>
															<Style TargetType="TextBlock">
																<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
																<Style.Triggers>
																	<DataTrigger Binding="{Binding Estado}" Value="Pagada">
																		<Setter Property="Foreground" Value="#2E7D32"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Estado}" Value="Anulada">
																		<Setter Property="Foreground" Value="#C62828"/>
																	</DataTrigger>
																	<DataTrigger Binding="{Binding Estado}" Value="Pendiente">
																		<Setter Property="Foreground" Value="#EF6C00"/>
																	</DataTrigger>
																</Style.Triggers>
															</Style>
														</TextBlock.Style>
													</TextBlock>
												</Border>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</Border>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
