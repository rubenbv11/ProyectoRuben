<UserControl x:Class="ProyectoRuben.Frontend.UCClientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ ENCABEZADO ══ -->
		<Border Grid.Row="0" Background="White" Padding="32,24"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Gestión de Clientes" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Administra y visualiza el registro de clientes de la peluquería"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}" Margin="0,4,0,0"/>
				</StackPanel>
				<Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}"
                        Foreground="White" Height="40" Padding="16,0" Cursor="Hand"
                        Command="{Binding AgregarClienteCommand}"
                        Visibility="{Binding MostrandoActivos, Converter={StaticResource BooleanToVisibilityConverter}}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
						<TextBlock Text="Nuevo Cliente" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!-- ══ TABS + BÚSQUEDA ══ -->
		<Border Grid.Row="1" Background="White" Padding="32,12"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="360"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Tabs -->
				<Border Grid.Column="0" Background="{StaticResource LightGrayBrush}" CornerRadius="8" Padding="4">
					<StackPanel Orientation="Horizontal">
						<Button Command="{Binding MostrarActivosCommand}" Height="32" Padding="16,0" BorderThickness="0" Cursor="Hand">
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="Button">
												<Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding MostrandoActivos}" Value="True">
											<Setter Property="Background" Value="White"/>
											<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<TextBlock Text="Activos" FontSize="13" FontWeight="SemiBold"/>
						</Button>
						<Button Command="{Binding MostrarArchivadosCommand}" Height="32" Padding="16,0" BorderThickness="0" Cursor="Hand">
							<Button.Style>
								<Style TargetType="Button">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="Button">
												<Border CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
													<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<Style.Triggers>
										<DataTrigger Binding="{Binding MostrandoArchivados}" Value="True">
											<Setter Property="Background" Value="White"/>
											<Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<TextBlock Text="Archivados" FontSize="13" FontWeight="SemiBold"/>
						</Button>
					</StackPanel>
				</Border>

				<!-- Buscador -->
				<Border Grid.Column="2" Background="{StaticResource LightGrayBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource MediumGrayBrush}" BorderThickness="1">
					<Grid>
						<materialDesign:PackIcon Kind="Magnify" Foreground="{StaticResource TextLightBrush}"
                                                 Width="18" Height="18" Margin="12,0,0,0"
                                                 VerticalAlignment="Center" HorizontalAlignment="Left"/>
						<TextBox Text="{Binding FiltroNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="36,0,10,0" Height="36" BorderThickness="0"
                                 Background="Transparent" Foreground="{StaticResource TextBrush}"
                                 FontSize="13" VerticalContentAlignment="Center">
							<TextBox.Template>
								<ControlTemplate TargetType="TextBox">
									<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
								</ControlTemplate>
							</TextBox.Template>
						</TextBox>
						<TextBlock Text="Buscar por nombre..." Foreground="{StaticResource TextLightBrush}"
                                   FontSize="13" Margin="38,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
				</Border>

				<!-- Contador -->
				<StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
					<TextBlock FontSize="13" Foreground="{StaticResource TextLightBrush}">
						<Run Text="{Binding TotalClientes}"/>
						<Run Text="clientes"/>
					</TextBlock>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ CONTENIDO ══ -->
		<Grid Grid.Row="2">
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource MediumGrayBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
					<materialDesign:PackIcon Kind="AccountOff" Foreground="White" Width="36" Height="36"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Border>
				<TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6">
					<TextBlock.Style>
						<Style TargetType="TextBlock">
							<Setter Property="Text" Value="Sin clientes registrados"/>
							<Style.Triggers>
								<DataTrigger Binding="{Binding MostrandoArchivados}" Value="True">
									<Setter Property="Text" Value="Sin clientes archivados"/>
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
				</TextBlock>
			</StackPanel>

			<ScrollViewer Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding ListaClientesView}" Padding="28,20,28,28">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Margin="0,0,0,10" Background="White" CornerRadius="12" Padding="20,16">
								<Border.Effect>
									<DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.05"/>
								</Border.Effect>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<!-- Avatar -->
									<Grid Grid.Column="0" Margin="0,0,16,0">
										<Ellipse Width="48" Height="48" Fill="{StaticResource AccentBrush}"/>
										<TextBlock Text="{Binding Nombre, Converter={StaticResource StringToFirstCharConverter}}"
                                                   Foreground="White" FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Grid>

									<!-- Info -->
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
											<TextBlock Text="{Binding Nombre}" FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
											<Border Margin="10,0,0,0" Background="#FFF4E0" CornerRadius="99" Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding EsVip, Converter={StaticResource BooleanToVisibilityConverter}}">
												<TextBlock Text="VIP" FontSize="10" FontWeight="SemiBold" Foreground="#A0622A"/>
											</Border>
										</StackPanel>
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Kind="Phone" Width="13" Height="13"
                                                                     Foreground="{StaticResource TextLightBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
											<TextBlock Text="{Binding Telefono}" FontSize="12"
                                                       Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"/>
											<Rectangle Width="1" Height="12" Fill="{StaticResource MediumGrayBrush}" Margin="12,0" VerticalAlignment="Center"/>
											<materialDesign:PackIcon Kind="Email" Width="13" Height="13"
                                                                     Foreground="{StaticResource TextLightBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
											<TextBlock Text="{Binding Email}" FontSize="12"
                                                       Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="220"/>
										</StackPanel>
									</StackPanel>

									<!-- Badge estado -->
									<Border Grid.Column="2" Margin="16,0" CornerRadius="99" Padding="12,4" VerticalAlignment="Center">
										<Border.Style>
											<Style TargetType="Border">
												<Setter Property="Background" Value="#E8F5E9"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding DataContext.MostrandoArchivados, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
														<Setter Property="Background" Value="#FFF3E0"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Border.Style>
										<TextBlock FontSize="11" FontWeight="SemiBold">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="Text" Value="Activo"/>
													<Setter Property="Foreground" Value="#2E7D32"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding DataContext.MostrandoArchivados, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
															<Setter Property="Text" Value="Archivado"/>
															<Setter Property="Foreground" Value="#EF6C00"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Border>

									<!-- Botones -->
									<StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">

										<!-- Editar (solo Activos) -->
										<Button Width="34" Height="34" Background="Transparent"
                                                BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                                                Cursor="Hand" Margin="0,0,6,0" ToolTip="Editar cliente"
                                                Command="{Binding DataContext.EditarClienteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
														<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Foreground="{StaticResource TextLightBrush}"/>
										</Button>

										<!-- Historial (solo Activos) -->
										<Button Width="34" Height="34" Background="Transparent"
                                                BorderThickness="1" BorderBrush="{StaticResource MediumGrayBrush}"
                                                Cursor="Hand" Margin="0,0,6,0" ToolTip="Ver historial"
                                                Command="{Binding DataContext.VerHistorialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
														<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<materialDesign:PackIcon Kind="History" Width="16" Height="16" Foreground="{StaticResource TextLightBrush}"/>
										</Button>

										<!-- Archivar (solo Activos) -->
										<Button Width="34" Height="34" Background="#FFF0F0"
                                                BorderThickness="1" BorderBrush="#FFCDD2"
                                                Cursor="Hand" ToolTip="Archivar cliente"
                                                Command="{Binding DataContext.DesactivarClienteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                Visibility="{Binding DataContext.MostrandoActivos, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
														<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<materialDesign:PackIcon Kind="ArchiveArrowDown" Width="16" Height="16" Foreground="#D63031"/>
										</Button>

										<!-- Reactivar (solo Archivados) -->
										<Button Width="34" Height="34" Background="#E8F5E9"
                                                BorderThickness="1" BorderBrush="#C8E6C9"
                                                Cursor="Hand" ToolTip="Reactivar cliente"
                                                Command="{Binding DataContext.ReactivarClienteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}"
                                                Visibility="{Binding DataContext.MostrandoArchivados, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border CornerRadius="8" Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
														<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<materialDesign:PackIcon Kind="Restore" Width="16" Height="16" Foreground="#2E7D32"/>
										</Button>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
