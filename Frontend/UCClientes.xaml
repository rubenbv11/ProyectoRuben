<UserControl x:Class="ProyectoRuben.Frontend.UCClientes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             Background="{StaticResource LightGrayBrush}">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- ══ ENCABEZADO ══ -->
		<Border Grid.Row="0" Background="White" Padding="32,24"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<StackPanel Grid.Column="0" VerticalAlignment="Center">
					<TextBlock Text="Gestión de Clientes"
                               FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
					<TextBlock Text="Administra y visualiza el registro de clientes de la peluquería"
                               FontSize="13" Foreground="{StaticResource TextLightBrush}"
                               Margin="0,4,0,0"/>
				</StackPanel>

				<Button Grid.Column="1"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource AccentBrush}"
                        BorderBrush="{StaticResource AccentBrush}"
                        Foreground="White" Height="40"
                        Padding="16,0" Cursor="Hand"
                        Command="{Binding AgregarClienteCommand}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<materialDesign:PackIcon Kind="Plus" Width="18" Height="18"
                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
						<TextBlock Text="Nuevo Cliente" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</Grid>
		</Border>

		<!-- ══ BARRA BÚSQUEDA + CONTADOR ══ -->
		<Border Grid.Row="1" Background="White" Padding="32,14"
                BorderThickness="0,0,0,1" BorderBrush="{StaticResource MediumGrayBrush}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="360"/>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>

				<!-- Buscador -->
				<Border Grid.Column="0" Background="{StaticResource LightGrayBrush}"
                        CornerRadius="8" BorderBrush="{StaticResource MediumGrayBrush}"
                        BorderThickness="1">
					<Grid>
						<materialDesign:PackIcon Kind="Magnify"
                                                 Foreground="{StaticResource TextLightBrush}"
                                                 Width="18" Height="18"
                                                 Margin="12,0,0,0"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Left"/>
						<TextBox Text="{Binding FiltroNombre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="36,0,10,0" Height="36"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource TextBrush}"
                                 FontSize="13" VerticalContentAlignment="Center">
							<TextBox.Template>
								<ControlTemplate TargetType="TextBox">
									<ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"/>
								</ControlTemplate>
							</TextBox.Template>
						</TextBox>
						<TextBlock Text="Buscar por nombre..."
                                   Foreground="{StaticResource TextLightBrush}"
                                   FontSize="13" Margin="38,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
										<DataTrigger Binding="{Binding FiltroNombre}" Value="{x:Null}">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</Grid>
				</Border>

				<!-- Contador -->
				<StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
					<TextBlock FontSize="13" Foreground="{StaticResource TextLightBrush}">
						<Run Text="{Binding TotalClientes}"/>
						<Run Text="clientes activos"/>
					</TextBlock>
				</StackPanel>
			</Grid>
		</Border>

		<!-- ══ LISTA / ESTADO VACÍO ══ -->
		<Grid Grid.Row="2">

			<!-- Estado vacío -->
			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}}">
				<Border Width="72" Height="72" CornerRadius="36"
                        Background="{StaticResource MediumGrayBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
					<materialDesign:PackIcon Kind="AccountOff" Foreground="White"
                                             Width="36" Height="36"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
				</Border>
				<TextBlock Text="Sin clientes registrados"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,6"/>
				<TextBlock Text="Comienza agregando tu primer cliente"
                           FontSize="13" Foreground="{StaticResource TextLightBrush}"
                           HorizontalAlignment="Center"/>
			</StackPanel>

			<!-- Lista de cards horizontales -->
			<ScrollViewer Visibility="{Binding EstaVacio, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
				<ItemsControl ItemsSource="{Binding ListaClientesView}"
                              Padding="28,20,28,28">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<!-- ── CARD HORIZONTAL ── -->
							<Border Margin="0,0,0,10"
                                    Background="White"
                                    CornerRadius="12"
                                    Padding="20,16">
								<Border.Effect>
									<DropShadowEffect BlurRadius="12" ShadowDepth="1"
                                                      Direction="270" Color="#000000" Opacity="0.05"/>
								</Border.Effect>

								<Grid>
									<Grid.ColumnDefinitions>
										<!-- Avatar -->
										<ColumnDefinition Width="Auto"/>
										<!-- Info -->
										<ColumnDefinition Width="*"/>
										<!-- Badge activo -->
										<ColumnDefinition Width="Auto"/>
										<!-- Botones -->
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<!-- ── Avatar circular ── -->
									<Grid Grid.Column="0" Margin="0,0,16,0">
										<Ellipse Width="48" Height="48"
                                                 Fill="{StaticResource AccentBrush}"/>
										<TextBlock Text="{Binding Nombre, Converter={StaticResource StringToFirstCharConverter}}"
                                                   Foreground="White"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
									</Grid>

									<!-- ── Nombre, VIP, contacto ── -->
									<StackPanel Grid.Column="1" VerticalAlignment="Center">

										<!-- Nombre + badge VIP -->
										<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
											<TextBlock Text="{Binding Nombre}"
                                                       FontSize="15" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       VerticalAlignment="Center"/>

											<!-- Badge VIP: solo visible si EsVip = true -->
											<Border Margin="10,0,0,0"
                                                    Background="#FFF4E0"
                                                    CornerRadius="99"
                                                    Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding EsVip, Converter={StaticResource BooleanToVisibilityConverter}}">
												<TextBlock Text="VIP"
                                                           FontSize="10" FontWeight="SemiBold"
                                                           Foreground="#A0622A"/>
											</Border>
										</StackPanel>

										<!-- Teléfono y email en línea -->
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Kind="Phone"
                                                                     Width="13" Height="13"
                                                                     Foreground="{StaticResource TextLightBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,5,0"/>
											<TextBlock Text="{Binding Telefono}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextLightBrush}"
                                                       VerticalAlignment="Center"/>

											<Rectangle Width="1" Height="12"
                                                       Fill="{StaticResource MediumGrayBrush}"
                                                       Margin="12,0" VerticalAlignment="Center"/>

											<materialDesign:PackIcon Kind="Email"
                                                                     Width="13" Height="13"
                                                                     Foreground="{StaticResource TextLightBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,5,0"/>
											<TextBlock Text="{Binding Email}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextLightBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="220"/>
										</StackPanel>
									</StackPanel>

									<!-- ── Badge estado Activo ── -->
									<Border Grid.Column="2"
                                            Margin="16,0"
                                            Background="#E8F5E9"
                                            CornerRadius="99"
                                            Padding="12,4"
                                            VerticalAlignment="Center">
										<TextBlock Text="Activo"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#2E7D32"/>
									</Border>

									<!-- ── Botones de acción ── -->
									<StackPanel Grid.Column="3"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">

										<!-- Editar -->
										<Button Width="34" Height="34"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource MediumGrayBrush}"
                                                Cursor="Hand"
                                                Margin="0,0,6,0"
                                                ToolTip="Editar cliente"
                                                Command="{Binding DataContext.EditarClienteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border CornerRadius="8"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
														<ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<materialDesign:PackIcon Kind="Pencil"
                                                                     Width="16" Height="16"
                                                                     Foreground="{StaticResource TextLightBrush}"/>
										</Button>

										<!-- Historial -->
										<Button Width="34" Height="34"
                                                Background="Transparent"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource MediumGrayBrush}"
                                                Cursor="Hand"
                                                Margin="0,0,6,0"
                                                ToolTip="Ver historial de citas"
                                                Command="{Binding DataContext.VerHistorialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border CornerRadius="8"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
														<ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<materialDesign:PackIcon Kind="History"
                                                                     Width="16" Height="16"
                                                                     Foreground="{StaticResource TextLightBrush}"/>
										</Button>

										<!-- Desactivar -->
										<Button Width="34" Height="34"
                                                Background="#FFF0F0"
                                                BorderThickness="1"
                                                BorderBrush="#FFCDD2"
                                                Cursor="Hand"
                                                ToolTip="Desactivar cliente"
                                                Command="{Binding DataContext.DesactivarClienteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding Id}">
											<Button.Template>
												<ControlTemplate TargetType="Button">
													<Border CornerRadius="8"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
														<ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
													</Border>
												</ControlTemplate>
											</Button.Template>
											<materialDesign:PackIcon Kind="TrashCanOutline"
                                                                     Width="16" Height="16"
                                                                     Foreground="#D63031"/>
										</Button>
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
